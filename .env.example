# =============================================================================
# Comis Environment Variables
# =============================================================================
#
# Copy this file to ~/.comis/.env and fill in the keys you need.
# The daemon loads ~/.comis/.env at startup. It snapshots recognized credential
# values in memory, then removes them from process.env so child processes do not
# inherit them.
#
# No variable in this file is universally required. Add only the credentials
# used by your configured model, channels, and optional integrations. OAuth or
# a local model can replace a static LLM key, and channels are optional.
#
# Do NOT commit real keys to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Encryption & Security
# ---------------------------------------------------------------------------

# Master key for encrypting secrets.db (AES-256-GCM). Comis creates one on the
# first encrypted-storage boot; to provide your own: openssl rand -hex 32
# SECRETS_MASTER_KEY=

# Canary token generation seed (auto-derived if unset)
# CANARY_SECRET=

# ---------------------------------------------------------------------------
# Static LLM Provider Keys (set only for providers you use)
# Full provider notes: docs/reference/environment-variables.mdx
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_OAUTH_TOKEN=             # Accepted alias; interactive OAuth is preferred
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=                    # Catalog alias for Google model calls
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=sk-...
# XAI_API_KEY=xai-...
# TOGETHER_API_KEY=
# CEREBRAS_API_KEY=csk-...
# OPENROUTER_API_KEY=sk-or-...

# Additional catalog providers
# ANT_LING_API_KEY=
# AI_GATEWAY_API_KEY=                # Vercel AI Gateway
# AZURE_OPENAI_API_KEY=
# CLOUDFLARE_API_KEY=
# COPILOT_GITHUB_TOKEN=
# FIREWORKS_API_KEY=
# HF_TOKEN=                          # Hugging Face
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# MOONSHOT_API_KEY=
# NVIDIA_API_KEY=
# OPENCODE_API_KEY=
# XIAOMI_API_KEY=
# XIAOMI_TOKEN_PLAN_CN_API_KEY=
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=
# ZAI_API_KEY=
# ZAI_CODING_CN_API_KEY=

# Companion values required by these providers
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=             # Cloudflare AI Gateway only
# GOOGLE_CLOUD_API_KEY=              # Google Vertex AI
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# ---------------------------------------------------------------------------
# Voice & Media
# ---------------------------------------------------------------------------

# Text-to-speech
# ELEVENLABS_API_KEY=sk_...        # ElevenLabs (premium voices)
#                                   # OpenAI TTS uses OPENAI_API_KEY above

# Speech-to-text
# DEEPGRAM_API_KEY=dg-...          # Deepgram Nova-3
#                                   # OpenAI Whisper uses OPENAI_API_KEY above
#                                   # Groq Whisper uses GROQ_API_KEY above

# Image generation
# FAL_KEY=                         # Explicit FAL image/video provider
#                                   # OpenAI image generation uses OPENAI_API_KEY above

# ---------------------------------------------------------------------------
# Web Search Providers
# ---------------------------------------------------------------------------

# SEARCH_API_KEY=BSA...             # Brave Search
# PERPLEXITY_API_KEY=pplx-...       # Perplexity AI
# TAVILY_API_KEY=tvly-...           # Tavily AI
# EXA_API_KEY=                      # Exa neural search
# JINA_API_KEY=jina_...             # Jina reader/search
#                                   # Grok search uses XAI_API_KEY above

# ---------------------------------------------------------------------------
# Channel Credentials
# ---------------------------------------------------------------------------

# Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_WEBHOOK_SECRET=          # Optional: webhook signature verification

# Discord
# DISCORD_BOT_TOKEN=MTIz...

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...          # Socket mode
# SLACK_SIGNING_SECRET=             # HTTP mode

# Microsoft Teams
# MSTEAMS_APP_PASSWORD=             # Secret-mode bot app credential

# LINE
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# IRC
# IRC_NICKSERV_PASSWORD=

# Email
# EMAIL_PASSWORD=
# EMAIL_OAUTH_CLIENT_ID=            # OAuth2 alternative to password
# EMAIL_OAUTH_CLIENT_SECRET=
# EMAIL_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Infrastructure (usually set via config.yaml instead)
# ---------------------------------------------------------------------------

# COMIS_CONFIG_PATHS=~/.comis/config.yaml
# COMIS_DATA_DIR=~/.comis
# COMIS_GATEWAY_TOKEN=              # Bearer referenced by gateway token config
# COMIS_OFFLINE=                    # Set to 1 to disable external tool provisioning
