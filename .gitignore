# Comis monorepo overrides
# Re-include files ignored by root .gitignore
!pnpm-lock.yaml
!packages/core/
!packages/core/**
!dist/

# Environment files (keep .example files)
.env
.env.*
!.env.example
!.env.docker.example
scripts/bench-memory.env
scripts/lcd-regression.env

# Comis-specific ignores
node_modules/
**/node_modules/
coverage/
# Vitest blob reports (sharded CI coverage merge — never committed)
.vitest-reports/
**/.vitest-reports/
.DS_Store
**/.DS_Store

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Claude Code working directory
.claude/

.planning/

# Build outputs (each package's dist/ is gitignored, built on CI)
packages/*/dist/
website/dist/
website/.astro/
*.tsbuildinfo

# Live-fire test tier — git-ignored runtime files (keys, cassettes, report)
test/live/live.env
test/live/cassettes/
.test-live-report.json
benchmarks/live/

# Integration test artifacts
test/.test-results.json
test/.test-behavioral-metrics.json
test/.test-daemon.log
test/config/*.last-good.yaml
# Nested config-git repo created by the test daemon's git-manager
# (configDir = test/config, so initRepo runs `git init` here)
test/config/.git/
test/config/.gitignore

# Playwright test results
**/test-results/

# npm pack output
packages/*/*.tgz

# Transient files from packages/comis/scripts/prepack.js
packages/comis/npm-shrinkwrap.json
packages/comis/package-lock.json
packages/comis/package.json.workspace-backup

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Database files
*.db
*.sqlite

# Log files
*.log

design/

# Live-test rig per-box secret (kit: test/live/self-driving) — never commit the real gateway token
test/live/self-driving/scripts/.live-env
