# SPDX-License-Identifier: Apache-2.0
# Live-fire test environment template.
# Copy to test/live/live.env and fill in real values.
# live.env is git-ignored; this example file is committed.
#
# Usage: pnpm test:live --dry   (preview plan + cost estimate)
#        pnpm test:live core     (real-LLM core loop tests)
#        pnpm test:live all      (everything available creds + budget allow)

# Master gate — set to 1 to enable live tests
COMIS_LIVE=1

# Hard budget ceiling per run (USD); cost governor aborts on breach
COMIS_LIVE_BUDGET_USD=2.00

# Which providers to target (comma-separated).
# NOTE: not yet consumed by the runner — filtering is done via credential presence only.
# Reserved for a future phase that adds provider-selection logic to the runner.
# # COMIS_LIVE_PROVIDERS=anthropic,openai,google

# Provider API keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# DEEPGRAM_API_KEY=...
# ELEVENLABS_API_KEY=...
# FAL_KEY=...
# BRAVE_API_KEY=...
# TAVILY_API_KEY=...
# EXA_API_KEY=...
# PERPLEXITY_API_KEY=...
# GROK_API_KEY=...

# Judge provider (for behavioral scoring — cross-judge requires ≥2)
# COMIS_LIVE_JUDGE_PROVIDER=anthropic
# COMIS_LIVE_JUDGE_MODEL=claude-3-5-haiku-20241022
# COMIS_LIVE_JUDGE_API_KEY=sk-ant-...

# ── Local GGUF model paths (MEM scenarios) ──────────────────────────────────
# Each MEM Stage-B test boots a daemon on a FRESH temp dataDir, so the default
# hf: model URIs would re-download ~146MB (embeddings) + ~636MB (reranker) into
# <dataDir>/models on EVERY boot. Point these at pre-downloaded GGUFs (e.g. the
# production daemon's ~/.comis/models/*) to keep Stage-B $0, offline, and fast.
# COMIS_LIVE_EMBED_MODEL_PATH=/abs/path/to/nomic-embed-text-v1.5.Q8_0.gguf
# COMIS_LIVE_RERANKER_MODEL_PATH=/abs/path/to/bge-reranker-v2-m3-Q8_0.gguf

# ── Local models (qwen3.6 family) ──────────────────────────────────────────────
# Drives scenarios/local/local-models.test.ts. Needs a local `ollama serve` with
# qwen3.6 tags pulled (qwen3.6:35b / :27b / :27b-mlx / :35b-mlx). No keys; on-device.
#   COMIS_LIVE_OLLAMA_URL=http://localhost:11434      # default
#   COMIS_LIVE_LOCAL_MODELS=qwen3.6:35b,qwen3.6:27b   # default: auto-discover every qwen3.6 tag
# Run just the local tier:
#   COMIS_LIVE=1 npx vitest run --config test/live/vitest.config.ts \
#     test/live/scenarios/local/local-models.test.ts
# Comparative report (security + efficiency tables across the family):
#   BENCH_MODELS="qwen3.6:35b,qwen3.6:27b,qwen3.6:27b-mlx" node scripts/bench-small-model/run.mjs
