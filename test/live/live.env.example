# SPDX-License-Identifier: Apache-2.0
# Live-fire test environment template.
# Copy to test/live/live.env and fill in real values.
# live.env is git-ignored; this example file is committed.
#
# Usage: pnpm test:live --dry   (preview plan + cost estimate)
#        pnpm test:live core     (real-LLM core loop tests)
#        pnpm test:live all      (everything available creds + budget allow)

# Master gate — set to 1 to enable live tests
COMIS_LIVE=1

# Hard budget ceiling per run (USD); cost governor aborts on breach
COMIS_LIVE_BUDGET_USD=2.00

# Which providers to target (comma-separated)
COMIS_LIVE_PROVIDERS=anthropic,openai,google

# Provider API keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# DEEPGRAM_API_KEY=...
# ELEVENLABS_API_KEY=...
# FAL_KEY=...
# BRAVE_API_KEY=...
# TAVILY_API_KEY=...
# EXA_API_KEY=...
# PERPLEXITY_API_KEY=...
# GROK_API_KEY=...

# Judge provider (for behavioral scoring — cross-judge requires ≥2)
# COMIS_LIVE_JUDGE_PROVIDER=anthropic
# COMIS_LIVE_JUDGE_MODEL=claude-3-5-haiku-20241022
# COMIS_LIVE_JUDGE_API_KEY=sk-ant-...
