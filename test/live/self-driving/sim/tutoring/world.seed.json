    "borrow-vs-place-value": {
      "topic": "fraction-addition",
      "obviousMisconception": "forgets to borrow / carry when summing the fractional parts of mixed numbers",
      "trueMisconception": "ignores the whole-number part entirely and only operates on the fractional part (e.g. 2&1/2 + 1&1/2 = 1 instead of 4)",
      "obviousKey": "no-carry",
      "trueKey": "drop-whole",
      "discriminatingProblem": "2&1/2 + 1&1/2 = ?",
      "answers": {
        "2&1/2 + 1&1/2 = ?": { "no-carry": "3&2/2", "drop-whole": "1", "correct": "4" },
        "3&1/4 + 1&1/4 = ?": { "no-carry": "4&2/4", "drop-whole": "1/2", "correct": "4&1/2" },
        "1&3/4 + 2&3/4 = ?": { "no-carry": "3&6/4", "drop-whole": "1&1/2", "correct": "4&1/2" }
