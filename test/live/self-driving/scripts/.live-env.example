# Production-capture and test-replay host profile. The controller refuses mutation unless both
# machines have distinct pinned identities and the configured roles are production -> test.
#
#   Setup:  cp .live-env.example .live-env   &&  $EDITOR .live-env   (it's gitignored — never committed)
#
# The rig targets the PRODUCTION installation that website/public/install.sh creates (or that
# scripts/install-vps.sh creates from this checkout): systemd `comis.service`, daemon as the
# dedicated service user, code at the npm-global comisai package, data dir ~<user>/.comis.
#
# The LOCAL scripts (install-vps.sh, deploy-dist.sh, deploy-scripts.sh, deploy-emu.sh,
# run-linux-tests.sh) AUTO-SOURCE ./.live-env; deploy-scripts.sh renders these values to
# /root/comis-rig.env ON the box, where the box-side scripts source them and the .mjs helpers read
# them via _rig.mjs. For ad-hoc one-liners, `source .live-env` first.
#
# These fields are mandatory for production capture/replay. Obtain each digest with the read-only
# command `sha256sum /etc/machine-id`; do not use abbreviated values.

export SOURCE_HOST="user@production-host"
export TARGET_HOST="user@test-host"
# Optional when an SSH endpoint does not use port 22. Keep the port separate from the host value.
# export SOURCE_SSH_PORT="2222"
# export TARGET_SSH_PORT="2202"
export SOURCE_ROLE="production"
export TARGET_ROLE="test"
export SOURCE_COMIS_USER="comis"
export TARGET_COMIS_USER="comis"
export SOURCE_DATA="/home/comis/.comis"
export TARGET_DATA="/home/comis/.comis"
export SOURCE_SERVICE="comis"
export TARGET_SERVICE="comis"
export SOURCE_MACHINE_ID_SHA256="REPLACE-WITH-64-CHAR-PRODUCTION-MACHINE-SHA256"
export TARGET_MACHINE_ID_SHA256="REPLACE-WITH-64-CHAR-TEST-MACHINE-SHA256"

# The remaining single-box fields support the existing synthetic live-test scripts while they are
# migrated onto the production replay controller. Point VPS only at the test machine.

export VPS="user@your-vps-host-or-ip" # ssh target — how you reach the test VPS (ssh KEY lives in ~/.ssh)
export COMIS_USER="comis"             # the dedicated service user install.sh creates
export COMIS_HOME="/home/comis"       # that user's home
export DATA="/home/comis/.comis"      # daemon data dir (config.yaml, secrets.db, logs, workspace)
export PKG="/home/comis/.npm-global/lib/node_modules/comisai" # installed package root (daemon+cli dist live under its node_modules/@comis/)
export SERVICE="comis"                # systemd unit name
export GW_PORT="4766"                 # gateway port (config.yaml gateway.port)
export CHATID="678314278"             # emulator chat/sender id to drive
export EMU_DIR="/root/comis-emu"      # emulator tree on the box (deploy-emu.sh rsyncs test/live/ here)

# Do not store gateway tokens or other credentials in this controller file. Box-side RPC helpers
# resolve their credential from the target's encrypted secret store for the duration of a command.
