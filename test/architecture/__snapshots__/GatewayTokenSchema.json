{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "secret": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 32
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "env",
                "file",
                "exec"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "provider",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scopes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcpClient": {
      "type": "object",
      "properties": {
        "allowlist": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessionAllowlist": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "toolRateLimit": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "allowlist",
        "sessionAllowlist",
        "toolRateLimit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "scopes"
  ],
  "additionalProperties": false
}