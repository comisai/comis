# ============================================================================
# Build the SPA
# ============================================================================
FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY patches/ patches/
COPY packages/web/package.json packages/web/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @comis/web...

COPY packages/web/ packages/web/
COPY packages/shared/ packages/shared/
COPY packages/core/ packages/core/

# Build shared → core → web in dependency order. `pnpm -r --filter @comis/web...`
# expands to web plus its transitive workspace deps and runs each build in
# topological order. Web imports system-time helpers from @comis/core, which
# vite resolves from core/dist/ at build time — so core must finish first.
RUN pnpm -r --filter @comis/web... run build

# ============================================================================
# Serve with Nginx
# ============================================================================
FROM nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752 AS final

# Custom nginx config with SPA fallback and reverse proxy
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built SPA
COPY --from=build /build/packages/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ || exit 1
