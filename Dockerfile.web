# ============================================================================
# Build the SPA
# ============================================================================
FROM node:22-bookworm-slim@sha256:813a7480f28fdadac1f7f5c824bcdad435b5bc1322a5968bbbdef8d058f9dff4 AS build

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/web/package.json packages/web/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @comis/web...

COPY packages/web/ packages/web/
COPY packages/shared/ packages/shared/
COPY packages/core/ packages/core/

# Build shared → core → web in dependency order. `pnpm -r --filter @comis/web...`
# expands to web plus its transitive workspace deps and runs each build in
# topological order. Web imports system-time helpers from @comis/core, which
# vite resolves from core/dist/ at build time — so core must finish first.
RUN pnpm -r --filter @comis/web... run build

# ============================================================================
# Serve with Nginx
# ============================================================================
FROM nginx:alpine@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa AS final

# Custom nginx config with SPA fallback and reverse proxy
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built SPA
COPY --from=build /build/packages/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ || exit 1
