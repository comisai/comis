{
  "name": "comis-workspace",
  "private": true,
  "description": "Security-first AI agent platform — connects AI agents to real-time chat channels",
  "author": "Moshe Anconina",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/comisai/comis.git"
  },
  "homepage": "https://github.com/comisai/comis#readme",
  "bugs": {
    "url": "https://github.com/comisai/comis/issues"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "contracts:generate": "npx tsx scripts/contracts/generate-web-artifact.ts",
    "cycles": "madge --circular --extensions ts packages/*/dist",
    "lint:security": "eslint --config eslint.config.js",
    "lint:fixtures": "bash scripts/check-fixture-diff.sh",
    "test": "vitest",
    "validate": "pnpm build && pnpm test && pnpm lint:security && pnpm cycles",
    "test:architecture": "vitest run --project architecture",
    "test:transparency": "vitest run packages/skills/src/__tests__/transparency-label-coverage.test.ts",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "smoke:tarball": "node scripts/smoke/tarball-smoke.mjs",
    "test:integration": "vitest run --config test/vitest.config.ts",
    "test:orchestrate": "npx tsx test/orchestrate.ts",
    "test:cleanup": "npx tsx test/support/cleanup-test-artifacts.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.22.1",
    "@comis/core": "workspace:*",
    "@line/bot-sdk": "10.8.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/web-api": "7.15.1",
    "@vitest/coverage-v8": "4.1.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.0",
    "eslint": "10.2.1",
    "eslint-plugin-security": "4.0.0",
    "globals": "17.5.0",
    "hono": "4.12.18",
    "madge": "8.0.0",
    "nodemailer": "8.0.7",
    "p-queue": "9.2.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5",
    "ws": "8.20.1",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.7",
      "typebox": "1.1.37",
      "protobufjs": ">=8.0.2",
      "@protobufjs/utf8": ">=1.1.1",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "lodash": ">=4.18.0",
      "basic-ftp": ">=5.3.1",
      "follow-redirects": ">=1.16.0",
      "axios": ">=1.15.0",
      "brace-expansion": ">=5.0.6",
      "nodemailer": ">=8.0.5",
      "music-metadata": ">=11.12.3",
      "vite": ">=7.3.2",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": ">=3.1.2",
      "uuid": ">=14.0.0",
      "@anthropic-ai/sdk": ">=0.91.1",
      "ip-address": ">=10.1.1",
      "qs": ">=6.15.2"
    }
  }
}
