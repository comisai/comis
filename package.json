{
  "name": "comis-workspace",
  "private": true,
  "description": "Security-first AI agent platform — connects AI agents to real-time chat channels",
  "author": "Moshe Anconina",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/comisai/comis.git"
  },
  "homepage": "https://github.com/comisai/comis#readme",
  "bugs": {
    "url": "https://github.com/comisai/comis/issues"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "node scripts/clean-build-artifacts.mjs",
    "build:clean": "pnpm clean && pnpm build",
    "contracts:generate": "npx tsx scripts/contracts/generate-web-artifact.ts",
    "sdk:generate": "npx tsx scripts/orchestrate-sdk/generate-comis-tools-sdk.ts",
    "cycles": "node scripts/check-cycles.mjs",
    "cycles:refs": "tsc -b --dry packages/comis",
    "lint:security": "eslint --config eslint.config.js",
    "lint:fixtures": "bash scripts/check-fixture-diff.sh",
    "docs:check": "node scripts/check-mdx.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm docs:check && pnpm build:clean && pnpm cycles && pnpm cycles:refs && pnpm lint:security && pnpm test:coverage",
    "validate:full": "pnpm validate && pnpm test:integration --coverage && pnpm smoke:tarball",
    "test:architecture": "vitest run --project architecture",
    "test:transparency": "vitest run packages/skills/src/__tests__/transparency-label-coverage.test.ts",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "smoke:tarball": "node scripts/smoke/tarball-smoke.mjs",
    "test:integration": "vitest run --config test/vitest.config.ts",
    "test:orchestrate": "npx tsx test/orchestrate.ts",
    "test:live": "npx tsx test/live/runner.ts",
    "test:cleanup": "npx tsx test/support/cleanup-test-artifacts.ts",
    "chan": "tsx test/live/bin/chan.ts",
    "chan:up": "tsx test/live/bin/chan.ts up",
    "chan:down": "tsx test/live/bin/chan.ts down",
    "tg": "tsx test/live/bin/chan.ts --channel telegram",
    "bench:memory": "bash scripts/bench-memory.sh",
    "hooks:install": "git config core.hooksPath .githooks || true",
    "prepare": "pnpm hooks:install"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.22.1",
    "@comis/core": "workspace:*",
    "@earendil-works/pi-agent-core": "0.79.3",
    "@earendil-works/pi-ai": "0.79.3",
    "@eslint/js": "10.0.1",
    "@line/bot-sdk": "10.8.0",
    "@mdx-js/mdx": "3.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/web-api": "7.16.0",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.8",
    "better-sqlite3": "12.10.0",
    "sqlite-vec": "0.1.9",
    "esbuild": "0.28.1",
    "eslint": "10.4.1",
    "eslint-plugin-security": "4.0.0",
    "globals": "17.6.0",
    "grammy": "1.43.0",
    "hono": "4.12.23",
    "madge": "8.0.0",
    "node-llama-cpp": "3.18.1",
    "nodemailer": "8.0.10",
    "p-queue": "9.3.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "remark-frontmatter": "5.0.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.7",
      "typebox": "1.2.8",
      "protobufjs": ">=8.0.2",
      "@protobufjs/utf8": ">=1.1.1",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "lodash": ">=4.18.0",
      "basic-ftp": ">=5.3.1",
      "follow-redirects": ">=1.16.0",
      "axios": ">=1.16.0",
      "brace-expansion": ">=5.0.6",
      "nodemailer": ">=8.0.5",
      "music-metadata": ">=11.12.3",
      "vite": ">=7.3.2",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": ">=3.1.2",
      "uuid": ">=14.0.0",
      "@anthropic-ai/sdk": ">=0.91.1",
      "ip-address": ">=10.1.1",
      "qs": ">=6.15.2"
    }
  }
}
