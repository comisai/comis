# =============================================================================
# Comis Docker Compose Environment
# =============================================================================
#
# Copy to .env in the project root before running: docker compose up
#
# This file configures Compose. Keep persistent provider and channel secrets
# in COMIS_ENV_FILE (default: ~/.comis/.env). The blank credential entries
# below are optional per-launch overrides; the container entrypoint unsets
# them when blank so they cannot shadow non-empty values in COMIS_ENV_FILE.
#
# PLATFORM NOTE: Production = Linux host only.
# macOS / Windows Docker Desktop runs in a linuxkit VM whose kernel does
# not allow nested PID-namespace + procfs mounts, which breaks the
# bubblewrap exec sandbox. To keep the agent usable for local testing,
# the daemon AUTO-DISABLES the sandbox on Docker Desktop and runs `exec`
# commands UNSANDBOXED inside the container. Trade-off: the agent works
# end-to-end, but a prompt-injected exec call can read /home/comis/.comis/.env, the
# encrypted secrets.db, /etc/comis/config.yaml — i.e. every credential
# the daemon owns inside the container.
#
# Docker Desktop = dev/testing only. Do NOT put real production secrets
# in this .env or anywhere under the data dir on a Mac/Windows host.
# For production deploy to a real Linux host (bare metal, VPS, or any
# Linux cloud VM) where the kernel actually allows the sandbox to run.
# See docs/operations/docker.mdx → Platform Support for details and the
# Lima / Colima-vz / OrbStack / UTM alternatives that get you a working
# sandbox on a Mac.
# =============================================================================

# ---------------------------------------------------------------------------
# Image Selection
# ---------------------------------------------------------------------------

# Use "comis:local" for local builds, or a registry image for production
COMIS_IMAGE=comis:local
COMIS_WEB_IMAGE=comis-web:local

# ---------------------------------------------------------------------------
# Data & Config Paths (host directories mounted into containers)
# ---------------------------------------------------------------------------

COMIS_DATA_DIR=~/.comis
COMIS_CONFIG_DIR=~/.comis
COMIS_ENV_FILE=~/.comis/.env

# ---------------------------------------------------------------------------
# Network Binding
# ---------------------------------------------------------------------------

# 127.0.0.1 = localhost only, 0.0.0.0 = all interfaces
COMIS_GATEWAY_HOST=127.0.0.1
COMIS_GATEWAY_PORT=4766
COMIS_WEB_HOST=127.0.0.1
COMIS_WEB_PORT=8080

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Gateway bearer auth token — generate with: openssl rand -hex 32
COMIS_GATEWAY_TOKEN=

# Encrypted secret storage is the default. Do not add SECRETS_MASTER_KEY to
# this Compose interpolation file. On first boot the daemon generates a key in
# the file at COMIS_ENV_FILE (default: ~/.comis/.env) with mode 0600. Back up
# that file: losing its key makes the encrypted secrets database unreadable.
#
# To provide an existing key, write a non-empty SECRETS_MASTER_KEY value to
# COMIS_ENV_FILE before starting the service. To use file storage instead,
# explicitly set `security.storage: file` in config.yaml; a blank key does not
# select file storage.

# ---------------------------------------------------------------------------
# LLM provider overrides
# ---------------------------------------------------------------------------

# Recommended: leave these blank and write persistent values to COMIS_ENV_FILE.
# The base Compose file passes through only these two provider overrides. Add
# other provider keys to COMIS_ENV_FILE so the daemon loads them directly.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional messaging-channel overrides
# ---------------------------------------------------------------------------

# Recommended: leave these blank and write persistent values to COMIS_ENV_FILE.
# The base Compose file passes through only these three channel overrides. Add
# other channel credentials to COMIS_ENV_FILE so the daemon loads them directly.

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
