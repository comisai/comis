{
  "name": "@comis/observability",
  "private": true,
  "version": "1.0.48",
  "author": "Moshe Anconina",
  "license": "Apache-2.0",
  "description": "Observability substrate (queued writer, payload bounding, sanitization, path guards) for Comis diagnostics artifacts",
  "keywords": ["comis", "ai", "agent", "observability", "diagnostics"],
  "engines": { "node": ">=22.19.0" },
  "files": ["dist"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/comisai/comis.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/comisai/comis#readme",
  "bugs": {
    "url": "https://github.com/comisai/comis/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/redact/edge-keeping.js": {
      "types": "./dist/redact/edge-keeping.d.ts",
      "import": "./dist/redact/edge-keeping.js",
      "default": "./dist/redact/edge-keeping.js"
    },
    "./dist/redact/pino-redact-transport.js": {
      "types": "./dist/redact/pino-redact-transport.d.ts",
      "import": "./dist/redact/pino-redact-transport.js",
      "default": "./dist/redact/pino-redact-transport.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@comis/core": "workspace:*",
    "@comis/shared": "workspace:*",
    "@earendil-works/pi-agent-core": "0.80.3",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
