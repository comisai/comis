{
  "name": "@comis/observability-otel",
  "private": true,
  "version": "1.0.42",
  "author": "Moshe Anconina",
  "license": "Apache-2.0",
  "description": "OTLP + Prometheus telemetry export for Comis (opt-in extension)",
  "keywords": ["comis", "ai", "agent", "opentelemetry", "prometheus", "otlp"],
  "engines": { "node": ">=22.19.0" },
  "files": ["dist"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/comisai/comis.git",
    "directory": "packages/observability-otel"
  },
  "homepage": "https://github.com/comisai/comis#readme",
  "bugs": {
    "url": "https://github.com/comisai/comis/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@comis/core": "workspace:*",
    "@comis/shared": "workspace:*",
    "@comis/observability": "workspace:*",
    "@comis/memory": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-prometheus": "0.219.0",
    "@opentelemetry/semantic-conventions": "1.41.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
