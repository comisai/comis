{
  "$id": "https://schemas.comis.ai/capability-service/mcp-call-context.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "conversationRef": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "managedRunGroupId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "managedRunId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "operationId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "rootRunId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "serviceInstanceId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "traceId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "workspacePolicyHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "operationId",
    "serviceInstanceId",
    "agentId",
    "conversationRef",
    "workspacePolicyHash",
    "rootRunId",
    "traceId"
  ],
  "type": "object"
}
