{
  "$id": "https://schemas.comis.ai/capability-service/report.request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "managedRuns.report",
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "artifactRefs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "details": {
          "maxLength": 16384,
          "type": "string"
        },
        "externalKey": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "attention",
            "blocked",
            "candidate_complete",
            "failed",
            "paused",
            "progress",
            "resolution"
          ],
          "type": "string"
        },
        "managedRunId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "observedAtMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "serviceReportId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "summary": {
          "maxLength": 16384,
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "managedRunId",
        "serviceReportId",
        "kind",
        "summary"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "type": "object"
}
