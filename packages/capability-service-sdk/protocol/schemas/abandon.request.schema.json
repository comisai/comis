{
  "$id": "https://schemas.comis.ai/capability-service/abandon.request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "managedRuns.abandon",
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "externalRunRef": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "operationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "reason": {
          "enum": [
            "activation_rejected",
            "owner_cancelled",
            "registration_expired",
            "service_unavailable"
          ],
          "type": "string"
        },
        "registrationNonce": {
          "maxLength": 256,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "externalRunRef",
        "registrationNonce",
        "reason"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "type": "object"
}
