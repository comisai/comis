{
  "$id": "https://schemas.comis.ai/capability-service/health.response.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "bundleDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "observedAtMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "protocolId": {
          "const": "comis.capability-service/1",
          "type": "string"
        },
        "reasonCodes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "serviceInstanceId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "status": {
          "enum": [
            "degraded",
            "healthy"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocolId",
        "bundleDigest",
        "serviceInstanceId",
        "status",
        "observedAtMs",
        "reasonCodes"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "type": "object"
}
