{
  "$id": "https://schemas.comis.ai/capability-service/groupAbandon.response.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "reap_safe",
            "preserve"
          ],
          "type": "string"
        },
        "managedRunGroupId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "members": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "managedRunId": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "completed",
                  "rejected",
                  "unknown",
                  "not_attempted"
                ],
                "type": "string"
              }
            },
            "required": [
              "managedRunId",
              "outcome"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "state": {
          "const": "abandoned",
          "type": "string"
        }
      },
      "required": [
        "managedRunGroupId",
        "members",
        "state",
        "disposition"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "type": "object"
}
