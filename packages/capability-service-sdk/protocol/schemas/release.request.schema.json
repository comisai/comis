{
  "$id": "https://schemas.comis.ai/capability-service/release.request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "managedRuns.release",
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "reap_safe",
            "preserve"
          ],
          "type": "string"
        },
        "managedRunId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "operationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "releasedAtMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "workspaceLeaseId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "managedRunId",
        "workspaceLeaseId",
        "disposition",
        "releasedAtMs"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "type": "object"
}
