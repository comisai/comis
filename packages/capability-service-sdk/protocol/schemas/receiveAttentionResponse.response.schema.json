{
  "$id": "https://schemas.comis.ai/capability-service/receiveAttentionResponse.response.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "jsonrpc": {
          "const": "2.0",
          "type": "string"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "externalKey": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "managedRunId": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            },
            "state": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "managedRunId",
            "externalKey",
            "state"
          ],
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "jsonrpc": {
          "const": "2.0",
          "type": "string"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "externalKey": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "managedRunId": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            },
            "response": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "const": "delivered",
              "type": "string"
            }
          },
          "required": [
            "managedRunId",
            "externalKey",
            "state",
            "response"
          ],
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "type": "object"
    }
  ]
}
