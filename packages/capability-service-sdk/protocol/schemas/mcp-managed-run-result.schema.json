{
  "$id": "https://schemas.comis.ai/capability-service/mcp-managed-run-result.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "displayLabel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
    },
    "externalRunRef": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "registrationNonce": {
      "maxLength": 256,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "requestedAttachment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "unix_socket",
            "inherited_descriptor"
          ],
          "type": "string"
        },
        "sourcePath": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sourcePath"
      ],
      "type": "object"
    },
    "requestedWorkspace": {
      "additionalProperties": false,
      "properties": {
        "rootHint": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rootHint"
      ],
      "type": "object"
    },
    "state": {
      "const": "prepared",
      "type": "string"
    }
  },
  "required": [
    "state",
    "externalRunRef",
    "registrationNonce",
    "expiresAt"
  ],
  "type": "object"
}
