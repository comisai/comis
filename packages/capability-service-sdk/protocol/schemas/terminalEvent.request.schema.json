{
  "$id": "https://schemas.comis.ai/capability-service/terminalEvent.request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "managedRuns.terminalEvent",
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "managedRunId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "operationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "terminalSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "transition": {
          "enum": [
            "created",
            "running",
            "input_needed",
            "stuck",
            "exited",
            "lost",
            "recovered",
            "released"
          ],
          "type": "string"
        },
        "workspaceLeaseId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "managedRunId",
        "workspaceLeaseId",
        "terminalSessionId",
        "transition"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "type": "object"
}
