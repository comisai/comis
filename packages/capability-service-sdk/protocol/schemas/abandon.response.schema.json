{
  "$id": "https://schemas.comis.ai/capability-service/abandon.response.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "reap_safe",
            "preserve"
          ],
          "type": "string"
        },
        "externalRunRef": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "state": {
          "const": "abandoned",
          "type": "string"
        },
        "terminalTransition": {
          "const": "unbound_preparation_abandoned",
          "type": "string"
        }
      },
      "required": [
        "externalRunRef",
        "state",
        "disposition",
        "terminalTransition"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "type": "object"
}
