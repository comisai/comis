{
  "class": "boundary-size",
  "name": "report summary byte boundary",
  "steps": [
    {
      "expectation": "accept",
      "payload": {
        "id": "operation_boundary_ok",
        "jsonrpc": "2.0",
        "method": "managedRuns.report",
        "params": {
          "kind": "progress",
          "managedRunId": "managed-run_a",
          "operationId": "operation_boundary_ok",
          "serviceReportId": "report_boundary_ok",
          "summary": ""
        }
      },
      "schemaExpectation": "accept",
      "target": "request"
    },
    {
      "expectation": "reject",
      "expectedErrorKind": "size_limit_exceeded",
      "payload": {
        "id": "operation_boundary_large",
        "jsonrpc": "2.0",
        "method": "managedRuns.report",
        "params": {
          "kind": "progress",
          "managedRunId": "managed-run_a",
          "operationId": "operation_boundary_large",
          "serviceReportId": "report_boundary_large",
          "summary": ""
        }
      },
      "schemaExpectation": "reject",
      "target": "request"
    }
  ]
}
