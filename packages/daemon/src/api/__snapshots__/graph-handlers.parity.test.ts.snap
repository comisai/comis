exports[`graph-handlers parity (FILE-SPLIT-05) > behavior matrix: representative inputs > validateGraphWarnings: emits expected warnings for problematic graph 1`] = `
"{
  "errors": [],
  "warnings": [
    {
      "fix": "Add \\"missing\\" to dependsOn, or remove the template reference.",
      "message": "Node \\"root\\" references {{missing.result}} but \\"missing\\" is not in its dependsOn",
      "nodeId": "root",
      "type": "unresolved_template"
    },
    {
      "fix": "Add this node to another node's dependsOn, or add a dependsOn referencing an upstream node.",
      "message": "Node \\"orphan\\" is disconnected — no dependsOn and nothing depends on it",
      "nodeId": "orphan",
      "type": "orphan_node"
    },
    {
      "fix": "Add more dependsOn entries for fan-in, or remove barrierMode.",
      "message": "Node \\"root\\" uses barrierMode \\"majority\\" but has only 0 dependency — barrier mode only matters with 2+ dependencies",
      "nodeId": "root",
      "type": "barrier_mode_low_deps"
    },
    {
      "fix": "Remove the agentId field from this typed node.",
      "message": "Node \\"typed\\" has both typeId \\"approval-gate\\" and agentId -- agentId is ignored for typed nodes (agents come from type_config)",
      "nodeId": "typed",
      "type": "typed_node_agentid_ignored"
    },
    {
      "fix": "Consider setting retries to 0 for typed nodes, or accept the cost of full re-execution.",
      "message": "Node \\"typed\\" has type \\"approval-gate\\" with retries=3 -- retrying re-runs the entire driver from scratch",
      "nodeId": "typed",
      "type": "typed_node_expensive_retry"
    },
    {
      "fix": "Set retries to 0 for approval-gate nodes.",
      "message": "Node \\"typed\\" is an approval-gate with retries=3 -- retry will re-prompt the user",
      "nodeId": "typed",
      "type": "typed_node_approval_retry"
    }
  ]
}"
`;

