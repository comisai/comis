{
  "name": "@comis/infra",
  "private": true,
  "version": "1.0.44",
  "author": "Moshe Anconina",
  "license": "Apache-2.0",
  "description": "Structured logging infrastructure for Comis",
  "keywords": ["comis", "ai", "agent", "logging", "pino"],
  "engines": { "node": ">=22.19.0" },
  "files": ["dist"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/comisai/comis.git",
    "directory": "packages/infra"
  },
  "homepage": "https://github.com/comisai/comis#readme",
  "bugs": {
    "url": "https://github.com/comisai/comis/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/logging/redact-transport.js": {
      "types": "./dist/logging/redact-transport.d.ts",
      "import": "./dist/logging/redact-transport.js",
      "default": "./dist/logging/redact-transport.js"
    },
    "./dist/logging/pipeline-redact-stage.js": {
      "types": "./dist/logging/pipeline-redact-stage.d.ts",
      "import": "./dist/logging/pipeline-redact-stage.js",
      "default": "./dist/logging/pipeline-redact-stage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@comis/core": "workspace:*",
    "@comis/observability": "workspace:*",
    "@comis/shared": "workspace:*",
    "@peculiar/asn1-cms": "2.7.0",
    "@peculiar/asn1-csr": "2.7.0",
    "@peculiar/asn1-ecc": "2.7.0",
    "@peculiar/asn1-pkcs9": "2.7.0",
    "@peculiar/asn1-rsa": "2.7.0",
    "@peculiar/asn1-schema": "2.7.0",
    "@peculiar/asn1-x509": "2.7.0",
    "@peculiar/x509": "2.0.0",
    "pino": "10.3.1",
    "pino-abstract-transport": "3.0.0",
    "pvtsutils": "1.3.6",
    "reflect-metadata": "0.2.2",
    "tslib": "2.8.1",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
