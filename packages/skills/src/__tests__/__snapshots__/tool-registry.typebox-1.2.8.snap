  {
    "name": "channels_manage",
    "category": "platform-admin",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "get",
              "type": "string"
            },
            {
              "const": "enable",
              "type": "string"
            },
            {
              "const": "disable",
              "type": "string"
            },
            {
              "const": "restart",
              "type": "string"
            },
            {
              "const": "configure",
              "type": "string"
            }
          ],
          "description": "Channel management action. Valid values: list (all adapters), get (single adapter details), enable (start adapter), disable (stop adapter), restart (stop then start), configure (toggle media setting)"
        },
        "channel_type": {
          "description": "The channel type (e.g. telegram, discord, slack). Required for get/enable/disable/restart/configure.",
          "type": "string"
        },
        "enabled": {
          "description": "Whether to enable (true) or disable (false) the setting. Required for configure action.",
          "type": "boolean"
        },
        "setting": {
          "description": "Media processing setting to toggle: transcribeAudio, analyzeImages, describeVideos, extractDocuments, understandLinks. Required for configure action.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "models_manage",
    "category": "platform-admin",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "list_providers",
              "type": "string"
            }
          ],
          "description": "Model management action. Valid values: list (query model catalog), test (check provider availability), list_providers (live native pi-ai catalog provider list for self-discovery)"
        },
        "provider": {
          "description": "Provider name to filter results (optional for list, required for test, ignored for list_providers). Examples: anthropic, openai, google, groq.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "providers_manage",
    "category": "platform-admin",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "get",
              "type": "string"
            },
            {
              "const": "create",
              "type": "string"
            },
            {
              "const": "update",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "enable",
              "type": "string"
            },
            {
              "const": "disable",
              "type": "string"
            }
          ],
          "description": "Provider management action. Valid values: list (view all providers), get (read config), create (register new provider), update (modify config), delete (remove provider), enable/disable (toggle availability)"
        },
        "config": {
          "anyOf": [
            {
              "description": "Provider configuration for create/update",
              "properties": {
                "apiKeyName": {
                  "description": "SecretManager key name for the API key (NOT the key itself). Store the key first via gateway env_set. Required for cloud providers; may be omitted for type='ollama' once keyless registration lands (until then, all entries with models[] need a resolvable apiKeyName).",
                  "type": "string"
                },
                "baseUrl": {
                  "description": "API base URL (e.g., https://integrate.api.nvidia.com/v1)",
                  "type": "string"
                },
                "enabled": {
                  "description": "Whether provider is active (default: true)",
                  "type": "boolean"
                },
                "headers": {
                  "description": "Custom headers for API requests",
                  "patternProperties": {
                    "^.*$": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "maxRetries": {
                  "description": "Max retries for transient errors (default: 2)",
                  "type": "integer"
                },
                "models": {
                  "description": "User-defined model entries for this provider",
                  "items": {
                    "properties": {
                      "contextWindow": {
                        "description": "Max context tokens",
                        "type": "integer"
                      },
                      "id": {
                        "description": "Model ID at provider (e.g., moonshotai/kimi-k2.5)",
                        "type": "string"
                      },
                      "input": {
                        "items": {
                          "anyOf": [
                            {
                              "const": "text",
                              "type": "string"
                            },
                            {
                              "const": "image",
                              "type": "string"
                            }
                          ]
                        },
                        "type": "array"
                      },
                      "maxTokens": {
                        "description": "Max output tokens",
                        "type": "integer"
                      },
                      "name": {
                        "description": "Display name",
                        "type": "string"
                      },
                      "reasoning": {
                        "description": "Supports extended thinking",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "description": "Human-readable display name",
                  "type": "string"
                },
                "timeoutMs": {
                  "description": "Request timeout in ms (default: 120000)",
                  "type": "integer"
                },
                "type": {
                  "description": "Provider SDK type -- determines the API protocol. Common values: openai (any OpenAI-compatible endpoint), anthropic, google, ollama, groq, mistral, together, deepseek, cerebras, xai, openrouter. Use 'openai' for custom/self-hosted endpoints that speak the OpenAI API format (NVIDIA NIM, vLLM, LM Studio, llama.cpp, Fireworks, Perplexity, etc.)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "description": "Provider config as JSON string (fallback). Prefer object form.",
              "type": "string"
            }
          ]
        },
        "provider_id": {
          "description": "The provider identifier (required for all actions except list) -- any user-chosen name (e.g., 'nvidia', 'deepseek', 'ollama-local', 'groq', 'my-vllm', 'company-internal')",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "skills_manage",
    "category": "platform-admin",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "import",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "create",
              "type": "string"
            },
            {
              "const": "update",
              "type": "string"
            }
          ],
          "description": "Skill management action. Valid values: list (show installed skills), import (install from GitHub URL), delete (remove skill by name), create (create new skill from content), update (modify existing skill content)"
        },
        "content": {
          "description": "Full SKILL.md content including frontmatter. Required for create and update actions. The agent should generate complete SKILL.md content with --- frontmatter --- and body.",
          "type": "string"
        },
        "description": {
          "description": "Skill description for frontmatter. Optional for create (overrides frontmatter description if provided).",
          "type": "string"
        },
        "name": {
          "description": "Skill name. Required for delete, create, and update actions.",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "shared",
              "type": "string"
            }
          ],
          "default": "local",
          "description": "Skill scope (default: local). Valid values: local (calling agent's workspace), shared (global skills visible to all agents)."
        },
        "url": {
          "description": "GitHub directory URL to import skills from. Required for import action.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "tokens_manage",
    "category": "platform-admin",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "create",
              "type": "string"
            },
            {
              "const": "revoke",
              "type": "string"
            },
            {
              "const": "rotate",
              "type": "string"
            }
          ],
          "description": "Token management action. Valid values: list (show active tokens), create (new token with scopes), revoke (invalidate token), rotate (atomic revoke and recreate)"
        },
        "scopes": {
          "description": "Token scopes (required for create, e.g. [\"rpc\", \"ws\", \"admin\"])",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "token_id": {
          "description": "Token identifier (required for revoke/rotate, optional for create -- auto-generated if omitted)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "cron",
    "category": "scheduling",
    "schema": {
      "properties": {
        "_confirmed": {
          "description": "Set to true when re-calling a destructive action after user approval. When a gated action returns requiresConfirmation, present the action to the user, and after they approve, call the same action again with _confirmed: true.",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "add",
              "type": "string"
            },
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "update",
              "type": "string"
            },
            {
              "const": "remove",
              "type": "string"
            },
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "runs",
              "type": "string"
            },
            {
              "const": "run",
              "type": "string"
            },
            {
              "const": "wake",
              "type": "string"
            }
          ],
          "description": "Cron scheduling action. Valid values: add (create new job), list (show all jobs), update (modify job config), remove (delete a job), status (scheduler health), runs (job execution history), run (trigger job now), wake (wake scheduler loop)"
        },
        "enabled": {
          "description": "Enable or disable a job (for update)",
          "type": "boolean"
        },
        "job_name": {
          "description": "Job name (required for update, remove, runs, run)",
          "type": "string"
        },
        "limit": {
          "description": "Maximum number of run history entries (default 20)",
          "type": "integer"
        },
        "max_history_turns": {
          "description": "Number of recent turns to keep for rolling strategy (default 3)",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "const": "force",
              "type": "string"
            },
            {
              "const": "due",
              "type": "string"
            }
          ],
          "description": "Run mode (default: force). Valid values: force (ignore schedule, run now), due (run only if overdue)"
        },
        "model": {
          "description": "Model to use when this cron job fires (e.g. gemini-2.5-flash). Only applies to agent_turn payload kind.",
          "type": "string"
        },
        "name": {
          "description": "Human-readable job name (for add/update)",
          "type": "string"
        },
        "payload_kind": {
          "anyOf": [
            {
              "const": "system_event",
              "type": "string"
            },
            {
              "const": "agent_turn",
              "type": "string"
            }
          ],
          "description": "Payload type. Valid values: system_event (cron/system triggers), agent_turn (agent-initiated runs)"
        },
        "payload_text": {
          "description": "Payload text or message content",
          "type": "string"
        },
        "schedule_at": {
          "description": "ISO 8601 datetime string (for schedule_kind=at)",
          "type": "string"
        },
        "schedule_every_ms": {
          "description": "Interval in milliseconds (for schedule_kind=every)",
          "type": "integer"
        },
        "schedule_expr": {
          "description": "Cron expression (for schedule_kind=cron)",
          "type": "string"
        },
        "schedule_kind": {
          "anyOf": [
            {
              "const": "cron",
              "type": "string"
            },
            {
              "const": "every",
              "type": "string"
            },
            {
              "const": "at",
              "type": "string"
            }
          ],
          "description": "Schedule type. Valid values: cron (recurring cron expression), every (repeat at fixed interval), at (one-shot at specific datetime)"
        },
        "session_strategy": {
          "anyOf": [
            {
              "const": "fresh",
              "type": "string"
            },
            {
              "const": "rolling",
              "type": "string"
            },
            {
              "const": "accumulate",
              "type": "string"
            }
          ],
          "description": "Session history strategy for recurring jobs. Valid values: fresh (new session each run; default and STRONGLY PREFERRED for cadences ≥ 10 minutes), rolling (keep last N turns; ONLY use when cadence < 5 minutes), accumulate (keep all history; rarely correct, leaks across runs). Rationale: cron uses a 5-minute prompt cache TTL, so any cadence longer than that wastes cache-write spend on rolling/accumulate — the cache is always cold by the next tick. Pick fresh unless cross-tick session memory is essential and cadence is < 5 minutes. Default: fresh"
        },
        "source": {
          "description": "Audit trail source identifier for wake action (default: agent)",
          "type": "string"
        },
        "timezone": {
          "description": "IANA timezone (e.g. America/New_York)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "session_search",
    "category": "session",
    "schema": {
      "properties": {
        "limit": {
          "description": "Maximum results to return (default: 10, max: 30)",
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "Search query -- one or more keywords. A message matches when ALL keywords appear in it (case-insensitive, order-independent); a single keyword matches as a substring. Omit for recent sessions metadata.",
          "type": "string"
        },
        "scope": {
          "description": "Filter by message role: 'all' (default), 'user', 'assistant', 'tool'",
          "type": "string"
        },
        "summarize": {
          "description": "Summarize matched sessions using LLM (default: true when query provided)",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "session_status",
    "category": "session",
    "schema": {
      "properties": {
        "model": {
          "description": "Optional model override for this session",
          "type": "string"
        }
      },
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "sessions_history",
    "category": "session",
    "schema": {
      "properties": {
        "limit": {
          "description": "Max messages to return (default: 20)",
          "type": "integer"
        },
        "offset": {
          "description": "Pagination offset (default: 0)",
          "type": "integer"
        },
        "session_key": {
          "description": "Target session key to retrieve history for",
          "type": "string"
        }
      },
      "required": [
        "session_key"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "sessions_list",
    "category": "session",
    "schema": {
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "all",
              "type": "string"
            },
            {
              "const": "dm",
              "type": "string"
            },
            {
              "const": "group",
              "type": "string"
            },
            {
              "const": "sub-agent",
              "type": "string"
            }
          ],
          "description": "Filter by session kind (default: all). Valid values: all (every session), dm (direct messages), group (group chats), sub-agent (sub-agent sessions)"
        },
        "since_minutes": {
          "description": "Only sessions active within N minutes",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "sessions_manage",
    "category": "session",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "reset",
              "type": "string"
            },
            {
              "const": "export",
              "type": "string"
            },
            {
              "const": "compact",
              "type": "string"
            }
          ],
          "description": "Session management action. Valid values: delete (archive and remove session), reset (clear messages, keep identity), export (download transcript as JSON), compact (reduce token usage)"
        },
        "instructions": {
          "description": "Optional instructions for compaction guidance (only used with compact action)",
          "type": "string"
        },
        "session_key": {
          "description": "The formatted session key (e.g., tenant:user:channel)",
          "type": "string"
        }
      },
      "required": [
        "action",
        "session_key"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "sessions_send",
    "category": "session",
    "schema": {
      "properties": {
        "max_turns": {
          "description": "Max ping-pong turns 0-5 (for ping-pong mode)",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "const": "fire-and-forget",
              "type": "string"
            },
            {
              "const": "wait",
              "type": "string"
            },
            {
              "const": "ping-pong",
              "type": "string"
            }
          ],
          "description": "Send mode (default: fire-and-forget). Valid values: fire-and-forget (send without waiting), wait (block for response), ping-pong (multi-turn exchange)"
        },
        "session_key": {
          "description": "Target session key to send the message to",
          "type": "string"
        },
        "text": {
          "description": "Message text to inject into target session",
          "type": "string"
        },
        "timeout_ms": {
          "description": "Wait timeout in ms (for wait/ping-pong modes)",
          "type": "integer"
        }
      },
      "required": [
        "session_key",
        "text"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "sessions_spawn",
    "category": "session",
    "schema": {
      "properties": {
        "agent": {
          "description": "Target agent ID for cross-agent spawning",
          "type": "string"
        },
        "announce_channel_id": {
          "description": "Channel ID for result announcement",
          "type": "string"
        },
        "announce_channel_type": {
          "description": "Channel type for result announcement",
          "type": "string"
        },
        "artifact_refs": {
          "description": "File paths for the sub-agent to reference (not inline content)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "async": {
          "description": "Spawn asynchronously, returns runId immediately (default: false)",
          "type": "boolean"
        },
        "domain_knowledge": {
          "description": "Domain knowledge entries for the sub-agent",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_outputs": {
          "description": "File paths to validate after sub-agent execution completes",
          "items": {
            "description": "Expected output file path",
            "type": "string"
          },
          "type": "array"
        },
        "include_parent_history": {
          "description": "Parent context inclusion: 'none' (default) or 'summary'",
          "type": "string"
        },
        "max_steps": {
          "description": "Maximum execution steps for this spawn. Floor of 30 (boot sequence needs ~10-15 steps). Typical values: 30 for quick lookups, 50 (default) for standard tasks, 80-100 for complex multi-step work. Capped at config default.",
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "description": "Optional model override for the sub-agent",
          "type": "string"
        },
        "objective": {
          "description": "Objective statement that survives context compaction",
          "type": "string"
        },
        "required_tools": {
          "description": "Tool names that must be reachable by the sub-agent; spawn fails immediately if any are outside the profile ceiling",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "description": "Task description for the sub-agent",
          "type": "string"
        },
        "tool_groups": {
          "description": "Tool group names for sub-agent tool filtering (e.g., 'coding', 'web')",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "task"
      ],
      "type": "object"
    },
    "conditional": false
  }
]