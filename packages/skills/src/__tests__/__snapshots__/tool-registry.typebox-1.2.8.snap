        },
        "action": {
          "anyOf": [
            {
              "const": "pin",
              "type": "string"
            },
            {
              "const": "unpin",
              "type": "string"
            },
            {
              "const": "kick",
              "type": "string"
            },
            {
              "const": "ban",
              "type": "string"
            },
            {
              "const": "unban",
              "type": "string"
            },
            {
              "const": "role_add",
              "type": "string"
            },
            {
              "const": "role_remove",
              "type": "string"
            },
            {
              "const": "set_topic",
              "type": "string"
            },
            {
              "const": "set_slowmode",
              "type": "string"
            },
            {
              "const": "guild_info",
              "type": "string"
            },
            {
              "const": "channel_info",
              "type": "string"
            },
            {
              "const": "threadCreate",
              "type": "string"
            },
            {
              "const": "threadList",
              "type": "string"
            },
            {
              "const": "threadReply",
              "type": "string"
            },
            {
              "const": "channelCreate",
              "type": "string"
            },
            {
              "const": "channelEdit",
              "type": "string"
            },
            {
              "const": "channelDelete",
              "type": "string"
            },
            {
              "const": "channelMove",
              "type": "string"
            },
            {
              "const": "setPresence",
              "type": "string"
            }
          ],
          "description": "Discord-specific action. Valid values: pin (pin message), unpin (unpin message), kick (remove member), ban (ban member), unban (unban member), role_add (assign role), role_remove (revoke role), set_topic (change channel topic), set_slowmode (set rate limit), guild_info (get server details), channel_info (get channel details), threadCreate (create thread), threadList (list threads), threadReply (reply in thread), channelCreate (new channel), channelEdit (modify channel), channelDelete (delete channel), channelMove (reorder channel), setPresence (update bot status)"
        },
        "activity_type": {
          "description": "Bot activity type: playing, watching, listening, competing (for setPresence)",
          "type": "string"
        },
        "auto_archive_duration": {
          "description": "Thread auto-archive duration in minutes: 60, 1440, 4320, 10080 (for threadCreate)",
          "type": "integer"
        },
        "channel_id": {
          "description": "Channel ID (for pin/unpin/set_topic/set_slowmode/channel_info/threadCreate/channelEdit/channelDelete/channelMove)",
          "type": "string"
        },
        "delete_message_days": {
          "description": "Days of messages to delete, 0-7 (for ban)",
          "type": "integer"
        },
        "guild_id": {
          "description": "Guild/server ID (for kick/ban/unban/role_add/role_remove/guild_info/channelCreate/threadList)",
          "type": "string"
        },
        "message_id": {
          "description": "Message ID (for pin/unpin/threadCreate)",
          "type": "string"
        },
        "name": {
          "description": "Name for thread or channel (for threadCreate/channelCreate)",
          "type": "string"
        },
        "parent_id": {
          "description": "Parent category ID (for channelCreate)",
          "type": "string"
        },
        "position": {
          "description": "Channel position in the list (for channelMove/channelEdit)",
          "type": "integer"
        },
        "reason": {
          "description": "Moderation reason (for kick/ban)",
          "type": "string"
        },
        "role_id": {
          "description": "Role ID (for role_add/role_remove)",
          "type": "string"
        },
        "seconds": {
          "description": "Slowmode delay in seconds, 0-21600 (for set_slowmode)",
          "type": "integer"
        },
        "status_text": {
          "description": "Bot status text (for setPresence)",
          "type": "string"
        },
        "thread_id": {
          "description": "Thread ID (for threadReply)",
          "type": "string"
        },
        "topic": {
          "description": "Channel topic text (for set_topic)",
          "type": "string"
        },
        "type": {
          "description": "Channel type: text, voice, category, announcement, forum, stage (for channelCreate)",
          "type": "string"
        },
        "user_id": {
          "description": "Target user ID (for kick/ban/unban/role_add/role_remove)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "message",
    "category": "messaging",
    "schema": {
      "properties": {
        "_confirmed": {
          "description": "Set to true when re-calling a destructive action after user approval. When a gated action returns requiresConfirmation, present the action to the user, and after they approve, call the same action again with _confirmed: true.",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "send",
              "type": "string"
            },
            {
              "const": "reply",
              "type": "string"
            },
            {
              "const": "react",
              "type": "string"
            },
            {
              "const": "edit",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "fetch",
              "type": "string"
            },
            {
              "const": "attach",
              "type": "string"
            }
          ],
          "description": "Message action. Valid values: send (new message), reply (respond to message), react (add emoji reaction), edit (modify sent message), delete (remove message), fetch (retrieve message history), attach (send file/media)"
        },
        "attachment_type": {
          "anyOf": [
            {
              "const": "image",
              "type": "string"
            },
            {
              "const": "file",
              "type": "string"
            },
            {
              "const": "audio",
              "type": "string"
            },
            {
              "const": "video",
              "type": "string"
            }
          ],
          "description": "Attachment media type (for attach, default: file). Valid values: image (photo/picture), file (generic document), audio (sound/voice), video (video clip)"
        },
        "attachment_url": {
          "description": "URL or workspace path of file to send: http(s)://, file://, or absolute path (for attach)",
          "type": "string"
        },
        "before": {
          "description": "Fetch messages before this message ID (for fetch)",
          "type": "string"
        },
        "buttons": {
          "description": "Button rows for interactive messages (for send/reply). Each inner array is one row of buttons.",
          "items": {
            "items": {
              "properties": {
                "callback_data": {
                  "maxLength": 64,
                  "type": "string"
                },
                "style": {
                  "anyOf": [
                    {
                      "const": "primary",
                      "type": "string"
                    },
                    {
                      "const": "secondary",
                      "type": "string"
                    },
                    {
                      "const": "danger",
                      "type": "string"
                    },
                    {
                      "const": "link",
                      "type": "string"
                    }
                  ],
                  "description": "Button style. Valid values: primary (prominent/blue), secondary (subtle/gray), danger (destructive/red), link (URL button)"
                },
                "text": {
                  "type": "string"
                },
                "url": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "array"
        },
        "caption": {
          "description": "Caption text for attachment (for attach)",
          "type": "string"
        },
        "cards": {
          "description": "Rich card embeds (for send/reply). Renders as embeds on Discord, blocks on Slack, HTML on Telegram.",
          "items": {
            "properties": {
              "color": {
                "type": "integer"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "items": {
                  "properties": {
                    "inline": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "image_url": {
                "format": "uri",
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "channel_id": {
          "description": "Target channel/chat identifier",
          "type": "string"
        },
        "channel_type": {
          "description": "Channel type: telegram, discord, slack, whatsapp",
          "type": "string"
        },
        "effects": {
          "description": "Message delivery effects (for send/reply). Valid values: spoiler (wraps text in spoiler), silent (suppresses notification)",
          "items": {
            "anyOf": [
              {
                "const": "spoiler",
                "type": "string"
              },
              {
                "const": "silent",
                "type": "string"
              }
            ]
          },
          "type": "array"
        },
        "emoji": {
          "description": "Emoji to react with, Unicode format (for react)",
          "type": "string"
        },
        "file_name": {
          "description": "Display filename (for attach)",
          "type": "string"
        },
        "limit": {
          "description": "Max messages to fetch, default 20 (for fetch)",
          "type": "integer"
        },
        "message_id": {
          "description": "Target message ID (for reply/react/edit/delete)",
          "type": "string"
        },
        "mime_type": {
          "description": "MIME type of attachment (for attach)",
          "type": "string"
        },
        "text": {
          "description": "Message text (for send/reply/edit)",
          "type": "string"
        },
        "thread_reply": {
          "description": "Create or continue a thread from this message (for send/reply). Discord creates thread, Slack uses thread_ts.",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "channel_type",
        "channel_id"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "notify",
    "category": "messaging",
    "schema": {
      "properties": {
        "channel_id": {
          "description": "Target channel/chat ID. Required when channel_type is specified.",
          "type": "string"
        },
