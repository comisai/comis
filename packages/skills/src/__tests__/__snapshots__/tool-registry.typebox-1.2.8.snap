            },
            {
              "const": "high",
              "type": "string"
            },
            {
              "const": "critical",
              "type": "string"
            }
          ],
          "description": "Notification priority. 'critical' bypasses quiet hours. Default: 'normal'."
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "conditional": false
  },
