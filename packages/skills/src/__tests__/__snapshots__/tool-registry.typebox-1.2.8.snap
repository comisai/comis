[
  {
    "name": "agents_manage",
    "category": "agent",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "create",
              "type": "string"
            },
            {
              "const": "get",
              "type": "string"
            },
            {
              "const": "update",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "suspend",
              "type": "string"
            },
            {
              "const": "resume",
              "type": "string"
            },
            {
              "const": "list",
              "type": "string"
            }
          ],
          "description": "Agent management action. Valid values: create (new agent), get (read config/status), update (modify config), delete (remove agent), suspend (pause execution), resume (restart execution), list (all agent IDs)"
        },
        "agent_id": {
          "description": "The agent identifier (required for all actions except list)",
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "description": "Agent configuration for create/update actions",
              "properties": {
                "maxSteps": {
                  "description": "Maximum execution steps per turn",
                  "type": "integer"
                },
                "model": {
                  "description": "LLM model identifier",
                  "type": "string"
                },
                "name": {
                  "description": "Human-readable agent name",
                  "type": "string"
                },
                "oauthProfiles": {
                  "description": "OAuth profile preferences per provider (e.g., openai-codex). Each value must match an existing stored profile ID — the daemon rejects nonexistent IDs with a 'not found in store' error.",
                  "patternProperties": {
                    "^.*$": {
                      "description": "<provider>:<identity> profile ID. Run `comis auth list` first to discover stored profiles.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "provider": {
                  "description": "LLM provider name",
                  "type": "string"
                },
                "skills": {
                  "description": "Skills and tool configuration",
                  "properties": {
                    "builtinTools": {
                      "description": "Built-in tool toggles (true=enabled, false=disabled)",
                      "properties": {
                        "browser": {
                          "description": "Enable headless browser control",
                          "type": "boolean"
                        },
                        "edit": {
                          "description": "Enable file editing",
                          "type": "boolean"
                        },
                        "exec": {
                          "description": "Enable shell command execution",
                          "type": "boolean"
                        },
                        "find": {
                          "description": "Enable file search by glob pattern",
                          "type": "boolean"
                        },
                        "grep": {
                          "description": "Enable regex search across files",
                          "type": "boolean"
                        },
                        "ls": {
                          "description": "Enable directory listing",
                          "type": "boolean"
                        },
                        "process": {
                          "description": "Enable background process management",
                          "type": "boolean"
                        },
                        "read": {
                          "description": "Enable file reading",
                          "type": "boolean"
                        },
                        "webFetch": {
                          "description": "Enable URL content fetching",
                          "type": "boolean"
                        },
                        "webSearch": {
                          "description": "Enable web search",
                          "type": "boolean"
                        },
                        "write": {
                          "description": "Enable file writing",
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "workspace": {
                  "additionalProperties": false,
                  "description": "Nested workspace configuration. Use this OR the flat workspace_profile field, not both. Optionally inline ROLE.md / IDENTITY.md via role/identity for single-call creation (PREFERRED for batch fleet creation).",
                  "properties": {
                    "identity": {
                      "description": "Inline IDENTITY.md content. Written to <workspaceDir>/IDENTITY.md immediately on create. Should set name/creature/vibe/emoji/avatar/ethos for the agent. Max 4096 chars. When omitted, IDENTITY.md is the unmodified seed template.",
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "profile": {
                      "anyOf": [
                        {
                          "const": "full",
                          "type": "string"
                        },
                        {
                          "const": "specialist",
                          "type": "string"
                        }
                      ],
                      "description": "Workspace profile (alternative to flat workspace_profile). Valid: full | specialist ONLY. NO other values accepted."
                    },
                    "role": {
                      "description": "Inline ROLE.md content. Written to <workspaceDir>/ROLE.md immediately on create. Should describe the agent's purpose, behavioral guidelines, domain conventions. Max 16384 chars. When omitted, ROLE.md is the unmodified seed template — call write() afterward to customize.",
                      "maxLength": 16384,
                      "type": "string"
                    }
                  },
                  "required": [
                    "profile"
                  ],
                  "type": "object"
                },
                "workspace_profile": {
                  "anyOf": [
                    {
                      "const": "full",
                      "type": "string"
                    },
                    {
                      "const": "specialist",
                      "type": "string"
                    }
                  ],
                  "description": "Workspace profile controlling platform instruction verbosity. Valid values: full (~9K tokens, user-facing agents on channels), specialist (~800 tokens, task workers and fleet sub-agents) ONLY. NO other values accepted. Default: full. Can be changed later via update action. Alternative shape: nested workspace.profile (see `workspace` field)."
                }
              },
              "type": "object"
            },
            {
              "description": "Agent configuration as a JSON string (fallback when the LLM stringifies the object). Will be parsed at execution time. Prefer the object form.",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "pipeline",
    "category": "agent",
    "schema": {
      "properties": {
        "_confirmed": {
          "description": "Set to true when re-calling a destructive action after user approval. When a gated action returns requiresConfirmation, present the action to the user, and after they approve, call the same action again with _confirmed: true.",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "define",
              "type": "string"
            },
            {
              "const": "execute",
              "type": "string"
            },
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "cancel",
              "type": "string"
            },
            {
              "const": "save",
              "type": "string"
            },
            {
              "const": "load",
              "type": "string"
            },
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "outputs",
              "type": "string"
            }
          ],
          "description": "Pipeline action (default: execute). Valid values: define (validate graph structure), execute (run pipeline), status (check graph state), cancel (terminate running graph), save (persist named graph), load (retrieve saved graph), list (enumerate saved graphs), delete (soft-delete saved graph), outputs (retrieve node results)"
        },
        "budget": {
          "description": "Resource budget limits for the graph",
          "properties": {
            "max_cost": {
              "description": "Maximum total cost across all nodes",
              "type": "number"
            },
            "max_tokens": {
              "description": "Maximum total tokens across all nodes",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "edges": {
          "description": "Edge definitions for the graph",
          "items": {
            "properties": {
              "from": {
                "description": "Alias for source (normalized automatically)",
                "type": "string"
              },
              "id": {
                "description": "Edge identifier (auto-generated as 'source->target' if omitted)",
                "type": "string"
              },
              "source": {
                "description": "Source node ID",
                "type": "string"
              },
              "target": {
                "description": "Target node ID",
                "type": "string"
              },
              "to": {
                "description": "Alias for target (normalized automatically)",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "graph_id": {
          "description": "Graph ID for status/cancel queries",
          "type": "string"
        },
        "id": {
          "description": "Named graph ID for save/load/delete",
          "type": "string"
        },
        "label": {
          "description": "Human-readable label for the graph",
          "type": "string"
        },
        "limit": {
          "description": "Max entries to return (for list)",
          "type": "integer"
        },
        "nodes": {
          "description": "Array of node definitions for the execution graph",
          "items": {
            "properties": {
              "agent": {
                "description": "Agent ID to run this node (default: caller's agent)",
                "type": "string"
              },
              "barrier_mode": {
                "anyOf": [
                  {
                    "const": "all",
                    "type": "string"
                  },
                  {
                    "const": "majority",
                    "type": "string"
                  },
                  {
                    "const": "best-effort",
                    "type": "string"
                  }
                ],
                "description": "Barrier mode for fan-in nodes. Valid values: all (wait for every dependency, default), majority (proceed when >50% deps complete), best-effort (proceed when any dep completes)"
              },
              "context_mode": {
                "anyOf": [
                  {
                    "const": "full",
                    "type": "string"
                  },
                  {
                    "const": "summary",
                    "type": "string"
                  },
                  {
                    "const": "none",
                    "type": "string"
                  }
                ],
                "description": "Context verbosity mode. Valid values: full (complete upstream outputs, default), summary (500 chars + shared dir reference), none (no upstream outputs, use {{nodeId.result}} for explicit data)"
              },
              "depends_on": {
                "description": "Node IDs this node depends on",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "max_steps": {
                "description": "Maximum execution steps for this node",
                "type": "integer"
              },
              "mcp_servers": {
                "description": "MCP server names whose tools should be pre-discovered for this node. Example: [\"yfinance\"] pre-seeds all yfinance tools so the sub-agent skips discover_tools calls.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "model": {
                "description": "Model override for this node",
                "type": "string"
              },
              "node_id": {
                "description": "Unique node identifier within the graph",
                "type": "string"
              },
              "retries": {
                "description": "Number of automatic retries on failure with exponential backoff (0-3, default: 0). Retry delays: 1s, 2s, 4s.",
                "maximum": 3,
                "minimum": 0,
                "type": "integer"
              },
              "task": {
                "description": "Task description for this node. Use {{nodeId.result}} to inline upstream node output (nodeId must be in depends_on). Use ${VARIABLE_NAME} for user-provided inputs.",
                "type": "string"
              },
              "timeout_ms": {
                "description": "Per-node timeout in milliseconds (default: 300000 — 5 minutes). Nodes with tool calls (web search, MCP, etc.) typically need 2-4 minutes. Debate and collaborate nodes need longer (5-8 minutes per round). Prefer the default unless you have a specific reason to change it.",
                "type": "integer"
              },
              "type_config": {
                "description": "Configuration for a MULTI-agent node type. MUST be set whenever type_id is set, and MUST be omitted when type_id is omitted (both-or-neither). For a single-agent node, set the node's \"agent\" field and OMIT both type_id and type_config. Set ONLY the fields for the chosen type_id. Examples (by type_id):\n  debate:        { \"agents\": [\"ta-bull\", \"ta-bear\"], \"rounds\": 2, \"synthesizer\": \"ta-judge\" }\n  vote:          { \"voters\": [\"analyst-1\", \"analyst-2\", \"analyst-3\"] }\n  refine:        { \"reviewers\": [\"drafter\", \"editor\", \"pm\"] }\n  collaborate:   { \"agents\": [\"team-1\", \"team-2\"], \"rounds\": 1 }\n  approval-gate: { \"message\": \"Approve the trade?\", \"timeout_minutes\": 60 }\n  map-reduce:    { \"mappers\": [{\"agent\": \"a1\"}, {\"agent\": \"a2\"}], \"reducer\": \"pm\" }",
                "properties": {
                  "agent": {
                    "description": "agent: agent ID to run (prefer the node-level \"agent\" field instead)",
                    "type": "string"
                  },
                  "agents": {
                    "description": "debate/collaborate: 2+ agent IDs",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "mappers": {
                    "description": "map-reduce: one entry per parallel mapper",
                    "items": {
                      "properties": {
                        "agent": {
                          "description": "map-reduce: agent ID for this mapper",
                          "type": "string"
                        },
                        "task_suffix": {
                          "description": "map-reduce: per-mapper task suffix",
                          "type": "string"
                        }
                      },
                      "required": [
                        "agent"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "max_steps": {
                    "description": "agent: maximum execution steps",
                    "type": "integer"
                  },
                  "message": {
                    "description": "approval-gate: message shown to the approver",
                    "type": "string"
                  },
                  "min_voters": {
                    "description": "vote: minimum voters required",
                    "type": "integer"
                  },
                  "model": {
                    "description": "agent: model override",
                    "type": "string"
                  },
                  "prompt_suffix": {
                    "description": "vote: extra instruction appended to each voter's prompt",
                    "type": "string"
                  },
                  "reducer": {
                    "description": "map-reduce: agent ID that reduces mapper outputs",
                    "type": "string"
                  },
                  "reducer_prompt": {
                    "description": "map-reduce: custom reducer instruction",
                    "type": "string"
                  },
                  "reviewers": {
                    "description": "refine: 2+ agent IDs in review-chain order",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "rounds": {
                    "description": "debate (1-5, default 2) / collaborate (1-3, default 1): number of rounds",
                    "type": "integer"
                  },
                  "synthesizer": {
                    "description": "debate: agent ID that synthesizes the final verdict",
                    "type": "string"
                  },
                  "timeout_minutes": {
                    "description": "approval-gate: approval timeout in minutes (default 60)",
                    "type": "number"
                  },
                  "verdict_format": {
                    "description": "vote: required verdict format description",
                    "type": "string"
                  },
                  "voters": {
                    "description": "vote: 2+ agent IDs voting independently",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "type_id": {
                "anyOf": [
                  {
                    "const": "agent",
                    "type": "string"
                  },
                  {
                    "const": "debate",
                    "type": "string"
                  },
                  {
                    "const": "vote",
                    "type": "string"
                  },
                  {
                    "const": "refine",
                    "type": "string"
                  },
                  {
                    "const": "collaborate",
                    "type": "string"
                  },
                  {
                    "const": "approval-gate",
                    "type": "string"
                  },
                  {
                    "const": "map-reduce",
                    "type": "string"
                  }
                ],
                "description": "Built-in node type for MULTI-agent orchestration. OMIT this for a regular single-agent node (just set \"agent\" + \"task\" — that already runs one sub-agent). Only set type_id when you need: debate (multi-round adversarial, ~N*R calls), vote (parallel independent voting, ~N calls), refine (sequential review chain, ~N calls), collaborate (sequential building, ~N*R calls), approval-gate (pause for human approval, 0 calls), map-reduce (parallel map then reduce, ~N+1 calls). Each of these REQUIRES a matching type_config. (\"agent\" is accepted but redundant — a node with \"agent\"+\"task\" already runs one sub-agent, so omit type_id instead.)"
              }
            },
            "required": [
              "node_id",
              "task"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "offset": {
          "description": "Pagination offset (for list)",
          "type": "integer"
        },
        "on_failure": {
          "anyOf": [
            {
              "const": "fail-fast",
              "type": "string"
            },
            {
              "const": "continue",
              "type": "string"
            }
          ],
          "description": "Failure strategy (default: fail-fast). Valid values: fail-fast (abort pipeline on first error), continue (skip failed node, proceed)"
        },
        "recent_minutes": {
          "description": "Include graphs from last N minutes (for status listing)",
          "type": "integer"
        },
        "settings": {
          "description": "Graph settings object"
        },
        "timeout_ms": {
          "description": "Overall graph timeout in milliseconds (default: 1500000 — 25 minutes). Heuristic: estimate ~3 minutes per node, double for debate/collaborate rounds. Multi-phase pipelines with debate rounds typically need 25-30 minutes. Do NOT lower below the default unless the graph is trivially small (2-3 simple nodes).",
          "type": "integer"
        },
        "variables": {
          "description": "Key-value map of ${VAR} substitutions to apply before execution",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "subagents",
    "category": "agent",
    "schema": {
      "properties": {
        "_confirmed": {
          "description": "Set to true when re-calling a destructive action after user approval. When a gated action returns requiresConfirmation, present the action to the user, and after they approve, call the same action again with _confirmed: true.",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "kill",
              "type": "string"
            },
            {
              "const": "steer",
              "type": "string"
            }
          ],
          "description": "Subagent action (default: list). Valid values: list (show active runs), kill (terminate sub-agent), steer (redirect task with new message)"
        },
        "message": {
          "description": "New task description for the subagent (for steer)",
          "type": "string"
        },
        "recent_minutes": {
          "description": "Include runs from last N minutes (default: 30, for list)",
          "type": "integer"
        },
        "target": {
          "description": "Run ID of the target subagent (for kill/steer)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "background_tasks",
    "category": "background",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "get",
              "type": "string"
            },
            {
              "const": "cancel",
              "type": "string"
            },
            {
              "const": "read_output",
              "type": "string"
            }
          ],
          "description": "Task management action. list: show all tasks for this agent. get: get task details by ID. cancel: cancel a running task. read_output: read the output of a completed task."
        },
        "taskId": {
          "description": "Task ID. Required for get, cancel, and read_output actions.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "browser",
    "category": "browser",
    "schema": {
      "properties": {
        "accept": {
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "start",
              "type": "string"
            },
            {
              "const": "stop",
              "type": "string"
            },
            {
              "const": "profiles",
              "type": "string"
            },
            {
              "const": "tabs",
              "type": "string"
            },
            {
              "const": "open",
              "type": "string"
            },
            {
              "const": "focus",
              "type": "string"
            },
            {
              "const": "close",
              "type": "string"
            },
            {
              "const": "snapshot",
              "type": "string"
            },
            {
              "const": "screenshot",
              "type": "string"
            },
            {
              "const": "navigate",
              "type": "string"
            },
            {
              "const": "console",
              "type": "string"
            },
            {
              "const": "pdf",
              "type": "string"
            },
            {
              "const": "upload",
              "type": "string"
            },
            {
              "const": "dialog",
              "type": "string"
            },
            {
              "const": "act",
              "type": "string"
            }
          ],
          "description": "Browser control action. Valid values: status (check browser state), start (launch browser), stop (close browser), profiles (list browser profiles), tabs (list open tabs), open (new tab with URL), focus (switch to tab), close (close tab), snapshot (get page accessibility tree), screenshot (capture page image), navigate (go to URL), console (read console logs), pdf (export page as PDF), upload (upload file to input), dialog (handle browser dialog), act (perform page interaction)"
        },
        "compact": {
          "type": "boolean"
        },
        "depth": {
          "type": "number"
        },
        "element": {
          "type": "string"
        },
        "frame": {
          "type": "string"
        },
        "fullPage": {
          "type": "boolean"
        },
        "inputRef": {
          "type": "string"
        },
        "interactive": {
          "type": "boolean"
        },
        "labels": {
          "type": "boolean"
        },
        "level": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "maxChars": {
          "type": "number"
        },
        "mode": {
          "anyOf": [
            {
              "const": "efficient",
              "type": "string"
            }
          ],
          "description": "Snapshot mode. Valid values: efficient (compact output for LLM)"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "type": "string"
        },
        "promptText": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "refs": {
          "anyOf": [
            {
              "const": "role",
              "type": "string"
            },
            {
              "const": "aria",
              "type": "string"
            }
          ],
          "description": "Element reference type. Valid values: role (ARIA role references), aria (ARIA label references)"
        },
        "request": {
          "properties": {
            "button": {
              "type": "string"
            },
            "doubleClick": {
              "type": "boolean"
            },
            "endRef": {
              "type": "string"
            },
            "fields": {
              "items": {
                "additionalProperties": true,
                "properties": {},
                "type": "object"
              },
              "type": "array"
            },
            "fn": {
              "type": "string"
            },
            "height": {
              "type": "number"
            },
            "key": {
              "type": "string"
            },
            "kind": {
              "anyOf": [
                {
                  "const": "click",
                  "type": "string"
                },
                {
                  "const": "type",
                  "type": "string"
                },
                {
                  "const": "press",
                  "type": "string"
                },
                {
                  "const": "hover",
                  "type": "string"
                },
                {
                  "const": "drag",
                  "type": "string"
                },
                {
                  "const": "select",
                  "type": "string"
                },
                {
                  "const": "fill",
                  "type": "string"
                },
                {
                  "const": "resize",
                  "type": "string"
                },
                {
                  "const": "wait",
                  "type": "string"
                },
                {
                  "const": "evaluate",
                  "type": "string"
                },
                {
                  "const": "close",
                  "type": "string"
                }
              ],
              "description": "Interaction kind. Valid values: click (click element), type (enter text), press (press key), hover (mouse over), drag (drag between elements), select (choose dropdown option), fill (fill form fields), resize (change viewport size), wait (pause or wait for condition), evaluate (run JavaScript), close (close current tab)"
            },
            "modifiers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "ref": {
              "type": "string"
            },
            "slowly": {
              "type": "boolean"
            },
            "startRef": {
              "type": "string"
            },
            "submit": {
              "type": "boolean"
            },
            "targetId": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "textGone": {
              "type": "string"
            },
            "timeMs": {
              "type": "number"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "selector": {
          "type": "string"
        },
        "snapshotFormat": {
          "anyOf": [
            {
              "const": "aria",
              "type": "string"
            },
            {
              "const": "ai",
              "type": "string"
            }
          ],
          "description": "Snapshot format. Valid values: aria (ARIA accessibility tree), ai (LLM-optimized format)"
        },
        "targetId": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "number"
        },
        "type": {
          "anyOf": [
            {
              "const": "png",
              "type": "string"
            },
            {
              "const": "jpeg",
              "type": "string"
            }
          ],
          "description": "Screenshot image format. Valid values: png (lossless), jpeg (compressed)"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "gateway",
    "category": "gateway",
    "schema": {
      "properties": {
        "_confirmed": {
          "description": "Set to true when re-calling a destructive action after user approval. When a gated action returns requiresConfirmation, present the action to the user, and after they approve, call the same action again with _confirmed: true.",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "const": "read",
              "type": "string"
            },
            {
              "const": "patch",
              "type": "string"
            },
            {
              "const": "apply",
              "type": "string"
            },
            {
              "const": "restart",
              "type": "string"
            },
            {
              "const": "schema",
              "type": "string"
            },
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "history",
              "type": "string"
            },
            {
              "const": "diff",
              "type": "string"
            },
            {
              "const": "rollback",
              "type": "string"
            },
            {
              "const": "env_set",
              "type": "string"
            },
            {
              "const": "env_list",
              "type": "string"
            }
          ],
          "description": "Gateway control action. Valid values: read (view config section), patch (update single config key), apply (replace entire section), restart (restart gateway), schema (get JSON schema), status (server uptime/connections), history (config change log), diff (compare config versions), rollback (restore previous config), env_set (store secret), env_list (list configured secret names -- read-only, never returns values)"
        },
        "env_key": {
          "description": "Environment variable / secret name (uppercase, e.g., OPENAI_API_KEY). Required for env_set. After storing a secret via env_set, reference it in config YAML as ${VAR_NAME} (e.g., GEMINI_API_KEY: ${GEMINI_API_KEY}). Never write raw API keys into config.",
          "type": "string"
        },
        "env_value": {
          "description": "Secret value to store. Required for env_set. Write-only: cannot be read back.",
          "type": "string"
        },
        "filter": {
          "description": "Glob filter for env_list (e.g., 'GEMINI*', '*_API_KEY'). Case-insensitive, supports '*' wildcard. Matches only secret NAMES -- values are never returned.",
          "type": "string"
        },
        "key": {
          "description": "Dot-notation key within section for patch. For agents section, prefix with the agent ID (e.g., default.model, default.provider, default.maxSteps). Use 'read' action first to see current keys and agent IDs.",
          "type": "string"
        },
        "limit": {
          "description": "Maximum results. For history: default 10. For env_list: default 100, max 500 (clamped).",
          "type": "number"
        },
        "section": {
          "description": "Config section name. Required for patch/apply/schema, optional for read. Valid sections: agents, channels, memory, security, routing, daemon, scheduler, gateway, integrations, monitoring, browser, models, providers, messages, approvals. Note: MCP server settings are under 'integrations', not 'mcp'.",
          "type": "string"
        },
        "sha": {
          "description": "Git commit SHA for diff comparison or rollback target",
          "type": "string"
        },
        "value": {
          "description": "New value for patch (string, number, boolean, object, or array)"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "obs_query",
    "category": "observability",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "diagnostics",
              "type": "string"
            },
            {
              "const": "billing",
              "type": "string"
            },
            {
              "const": "delivery",
              "type": "string"
            },
            {
              "const": "channels",
              "type": "string"
            },
            {
              "const": "explain",
              "type": "string"
            },
            {
              "const": "trace",
              "type": "string"
            },
            {
              "const": "session_report",
              "type": "string"
            },
            {
              "const": "fleet_health",
              "type": "string"
            }
          ],
          "description": "Observability query category. Valid values: diagnostics (platform diagnostic data), billing (cost data by provider/agent/session), delivery (message delivery traces), channels (channel activity and staleness), explain (assembled IncidentReport / root-cause post-mortem for a session), trace (search trace rows), session_report (session rollup — reuses the IncidentReport), fleet_health (cross-session fleet-health triage: degradation rate, recurring WARNs, model/config health over a window)"
        },
        "agent_id": {
          "description": "Agent identifier (for billing.byAgent)",
          "type": "string"
        },
        "category": {
          "description": "Diagnostic category filter (for diagnostics)",
          "type": "string"
        },
        "channel_id": {
          "description": "Channel identifier (for channels.get, delivery.recent)",
          "type": "string"
        },
        "depth": {
          "description": "Report depth for explain/session_report: summary | full",
          "type": "string"
        },
        "limit": {
          "description": "Maximum number of results to return",
          "type": "integer"
        },
        "session_key": {
          "description": "Session key (for billing.bySession)",
          "type": "string"
        },
        "since_hours": {
          "description": "Window in hours for fleet_health (default 24)",
          "type": "integer"
        },
        "since_ms": {
          "description": "Time filter: only include data since this epoch timestamp (ms)",
          "type": "integer"
        },
        "sub_action": {
          "description": "Sub-action within the category. billing: byProvider | byAgent | bySession | total. delivery: recent | stats. channels: all | stale | get.",
          "type": "string"
        },
        "threshold_ms": {
          "description": "Staleness threshold in ms (for channels.stale, default 300000)",
          "type": "integer"
        },
        "trace_id": {
          "description": "Trace ID (for explain, trace, session_report)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "heartbeat_manage",
    "category": "heartbeat",
    "schema": {
      "properties": {
        "ack_max_chars": {
          "description": "Max chars for soft acknowledgment (default 300)",
          "type": "integer"
        },
        "action": {
          "anyOf": [
            {
              "const": "get",
              "type": "string"
            },
            {
              "const": "update",
              "type": "string"
            },
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "trigger",
              "type": "string"
            }
          ],
          "description": "Heartbeat management action. Valid values: get (view config), update (modify config fields), status (runtime state for all agents), trigger (run heartbeat now)"
        },
        "agent_id": {
          "description": "Agent ID to manage (defaults to calling agent)",
          "type": "string"
        },
        "alert_cooldown_ms": {
          "description": "Minimum ms between alerts",
          "type": "integer"
        },
        "alert_threshold": {
          "description": "Consecutive failures before alerting",
          "type": "integer"
        },
        "allow_dm": {
          "description": "Allow DM delivery of heartbeat alerts",
          "type": "boolean"
        },
        "enabled": {
          "description": "Enable/disable heartbeat for this agent",
          "type": "boolean"
        },
        "interval_ms": {
          "description": "Heartbeat interval in milliseconds (e.g. 300000 for 5 min)",
          "type": "integer"
        },
        "light_context": {
          "description": "Use lightweight bootstrap context (HEARTBEAT.md only)",
          "type": "boolean"
        },
        "model": {
          "description": "Model override for heartbeat LLM calls",
          "type": "string"
        },
        "prompt": {
          "description": "Custom heartbeat prompt text",
          "type": "string"
        },
        "response_prefix": {
          "description": "Prefix to strip from LLM responses before delivery",
          "type": "string"
        },
        "session": {
          "description": "Session key for heartbeat conversation isolation",
          "type": "string"
        },
        "show_alerts": {
          "description": "Show alert notifications",
          "type": "boolean"
        },
        "show_ok": {
          "description": "Show OK status notifications",
          "type": "boolean"
        },
        "skip_heartbeat_only_delivery": {
          "description": "Suppress HEARTBEAT_OK-only delivery from cron triggers",
          "type": "boolean"
        },
        "stale_ms": {
          "description": "Max ms before stuck detection triggers",
          "type": "integer"
        },
        "target_channel_id": {
          "description": "Delivery target channel identifier",
          "type": "string"
        },
        "target_channel_type": {
          "description": "Delivery target channel type (e.g. telegram, discord)",
          "type": "string"
        },
        "target_chat_id": {
          "description": "Delivery target chat/conversation ID",
          "type": "string"
        },
        "target_is_dm": {
          "description": "Whether delivery target is a DM conversation",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "mcp_manage",
    "category": "mcp",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "list",
              "type": "string"
            },
            {
              "const": "status",
              "type": "string"
            },
            {
              "const": "connect",
              "type": "string"
            },
            {
              "const": "disconnect",
              "type": "string"
            },
            {
              "const": "reconnect",
              "type": "string"
            }
          ],
          "description": "MCP server management action. Valid values: list (all servers with status), status (detailed single server info), connect (add new server), disconnect (remove server), reconnect (restart server connection)"
        },
        "args": {
          "description": "Arguments for the stdio command (e.g. [\"-y\", \"@upstash/context7-mcp\"]).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "auth": {
          "anyOf": [
            {
              "const": "headers",
              "type": "string"
            },
            {
              "const": "oauth",
              "type": "string"
            }
          ],
          "description": "Auth scheme for remote transports. \"oauth\" triggers PKCE flow via mcp_login. Default: \"headers\" (credential injection via the headers field). Only relevant for sse/http transports."
        },
        "command": {
          "description": "Command to execute for stdio transport (e.g. npx). Required for stdio connect.",
          "type": "string"
        },
        "headers": {
          "description": "Custom HTTP headers for remote transports (e.g. Authorization). Keys are header names, values are header values.",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "server_name": {
          "description": "MCP server name. Required for status/connect/disconnect/reconnect.",
          "type": "string"
        },
        "transport": {
          "description": "Transport: 'stdio' (default when 'command' is provided), 'sse', or 'http' (default when 'url' is provided). Override only when both command and url are set, or to force a specific transport.",
          "type": "string"
        },
        "url": {
          "description": "Server URL for remote transport (sse or http). Required for sse/http connect.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "mcp_login",
    "category": "mcp",
    "schema": {
      "properties": {
        "server_name": {
          "description": "Name of the MCP server to start OAuth login for.",
          "type": "string"
        }
      },
      "required": [
        "server_name"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "get_prompt",
    "category": "mcp",
    "schema": {
      "properties": {
        "arguments": {
          "description": "Optional template arguments for the prompt, keyed by argument name",
          "patternProperties": {
            "^.*$": {}
          },
          "type": "object"
        },
        "name": {
          "description": "Prompt name to fetch (from list_prompts output)",
          "type": "string"
        },
        "server": {
          "description": "MCP server name (must be a connected server advertising prompts)",
          "type": "string"
        }
      },
      "required": [
        "server",
        "name"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "list_prompts",
    "category": "mcp",
    "schema": {
      "properties": {
        "server": {
          "description": "MCP server name (must be a connected server advertising prompts)",
          "type": "string"
        }
      },
      "required": [
        "server"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "list_resources",
    "category": "mcp",
    "schema": {
      "properties": {
        "server": {
          "description": "MCP server name (must be a connected server advertising resources)",
          "type": "string"
        }
      },
      "required": [
        "server"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "read_resource",
    "category": "mcp",
    "schema": {
      "properties": {
        "server": {
          "description": "MCP server name (must be a connected server advertising resources)",
          "type": "string"
        },
        "uri": {
          "description": "Resource URI to read (from list_resources output)",
          "type": "string"
        }
      },
      "required": [
        "server",
        "uri"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "describe_video",
    "category": "media",
    "schema": {
      "properties": {
        "attachment_url": {
          "description": "The attachment URL from the message hint (e.g. tg-file://..., discord://...)",
          "type": "string"
        },
        "prompt": {
          "description": "Custom analysis prompt to guide the video description",
          "type": "string"
        }
      },
      "required": [
        "attachment_url"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "extract_document",
    "category": "media",
    "schema": {
      "properties": {
        "attachment_url": {
          "description": "The attachment URL from the message hint (e.g. tg-file://..., discord://...)",
          "type": "string"
        },
        "max_chars": {
          "description": "Maximum number of characters to extract from the document",
          "type": "number"
        }
      },
      "required": [
        "attachment_url"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "image",
    "category": "media",
    "schema": {
      "properties": {
        "action": {
          "const": "analyze",
          "description": "The image action to perform",
          "type": "string"
        },
        "attachment_url": {
          "description": "Platform attachment URL from a message hint (tg-file://, discord://, etc.). When provided, overrides source_type/source for attachment-based images.",
          "type": "string"
        },
        "mime_type": {
          "description": "MIME type for base64 input (auto-detected if omitted)",
          "type": "string"
        },
        "prompt": {
          "description": "Analysis prompt (default: describe the image)",
          "type": "string"
        },
        "source": {
          "description": "File path, URL, or base64-encoded image data (required unless attachment_url is used)",
          "type": "string"
        },
        "source_type": {
          "anyOf": [
            {
              "const": "file",
              "type": "string"
            },
            {
              "const": "url",
              "type": "string"
            },
            {
              "const": "base64",
              "type": "string"
            }
          ],
          "description": "How the image source is provided (required unless attachment_url is used)"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "image_generate",
    "category": "media",
    "schema": {
      "properties": {
        "model": {
          "description": "Override the provider's default image model (e.g. gpt-image-1, gemini-2.5-flash-image). Rejected if not valid for the active provider. Omit to use the default.",
          "type": "string"
        },
        "prompt": {
          "description": "Text description of the image to generate.",
          "type": "string"
        },
        "reference_image": {
          "description": "A workspace file path, URL, or data-URI of a reference image for edit/img2img. Omit for text-to-image.",
          "type": "string"
        },
        "size": {
          "description": "Image size. Provider-specific: fal.ai uses presets (square_hd, landscape_16_9), OpenAI uses pixel dims (1024x1024, 1792x1024). Omit for default.",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "video_generate",
    "category": "media",
    "schema": {
      "properties": {
        "aspect_ratio": {
          "description": "Aspect ratio: 16:9 | 9:16 | 1:1 (provider-validated). Omit for default.",
          "type": "string"
        },
        "audio": {
          "description": "Generate audio (provider-dependent). Omit for the provider default.",
          "type": "boolean"
        },
        "duration": {
          "description": "Clip length in seconds (provider-validated). Omit for default.",
          "type": "number"
        },
        "image_url": {
          "description": "A workspace file path, URL, or data-URI of a source image for image-to-video. SSRF-guarded and workspace-confined by the handler. Omit for text-to-video.",
          "type": "string"
        },
        "model": {
          "description": "Override the provider's default video model/endpoint (e.g. fal-ai/veo3.1/fast). Omit to use the default.",
          "type": "string"
        },
        "negative_prompt": {
          "description": "Text describing what to avoid in the generated video.",
          "type": "string"
        },
        "prompt": {
          "description": "Text description of the video to generate.",
          "type": "string"
        },
        "resolution": {
          "description": "Resolution: 720p | 1080p | 4k (provider-validated). Omit for default.",
          "type": "string"
        },
        "seed": {
          "description": "Deterministic seed for reproducible generations (provider-dependent).",
          "type": "number"
        }
      },
      "required": [
        "prompt"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "video_status",
    "category": "media",
    "schema": {
      "properties": {
        "job_id": {
          "description": "The job handle returned by video_generate.",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "transcribe_audio",
    "category": "media",
    "schema": {
      "properties": {
        "attachment_url": {
          "description": "The attachment URL from the message hint (e.g. tg-file://..., discord://...)",
          "type": "string"
        },
        "language": {
          "description": "BCP-47 language hint to improve transcription accuracy (e.g. 'en', 'he', 'es')",
          "type": "string"
        }
      },
      "required": [
        "attachment_url"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "tts",
    "category": "media",
    "schema": {
      "properties": {
        "action": {
          "const": "synthesize",
          "description": "The TTS action to perform",
          "type": "string"
        },
        "format": {
          "description": "Audio format: mp3, opus, wav (default: from config)",
          "type": "string"
        },
        "text": {
          "description": "Text to convert to speech",
          "type": "string"
        },
        "voice": {
          "description": "Voice identifier (provider-specific)",
          "type": "string"
        }
      },
      "required": [
        "action",
        "text"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "memory_ask",
    "category": "memory",
    "schema": {
      "properties": {
        "limit": {
          "description": "Max memories to ground the answer over",
          "type": "number"
        },
        "question": {
          "description": "The question to answer from the agent's memory",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    },
    "conditional": true
  },
  {
    "name": "memory_get",
    "category": "memory",
    "schema": {
      "properties": {
        "end_line": {
          "description": "End line (1-based)",
          "type": "integer"
        },
        "path": {
          "description": "File path relative to workspace",
          "type": "string"
        },
        "start_line": {
          "description": "Start line (1-based)",
          "type": "integer"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "conditional": false
  },
  {
    "name": "memory_manage",
    "category": "memory",
    "schema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "const": "stats",
              "type": "string"
            },
            {
              "const": "browse",
              "type": "string"
            },
            {
              "const": "delete",
              "type": "string"
            },
            {
              "const": "flush",
              "type": "string"
            },
            {
              "const": "export",
              "type": "string"
            },
            {
              "const": "pin",
              "type": "string"
            },
            {
              "const": "unpin",
              "type": "string"
            }
          ],
          "description": "Memory management action. Valid values: stats (DB size and entry counts), browse (paginated entry listing), delete (remove entries by ID), flush (clear all entries for scope), export (full JSON export), pin (mark entry as always-injected in recall), unpin (remove always-inject mark)"
        },
        "agent_id": {
          "description": "Agent ID scope for filtering",
          "type": "string"
        },
        "id": {
          "description": "Memory entry ID (required for pin/unpin actions)",
          "type": "string"
        },
        "ids": {
          "description": "Array of memory entry IDs to delete (required for delete action)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "description": "Pagination limit (default: 20 for browse, 1000 for export)",
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        },
        "memory_type": {
          "description": "Filter by memory type (working, episodic, semantic, procedural)",
          "type": "string"
        },
        "offset": {
          "description": "Pagination offset (default: 0)",
          "minimum": 0,
          "type": "integer"
        },
        "sort": {
          "anyOf": [
            {
              "const": "newest",
              "type": "string"
            },
            {
              "const": "oldest",
              "type": "string"
            }
          ],
          "description": "Sort order for browse (default: newest). Valid values: newest (most recent first), oldest (earliest first)"
        },
        "tags": {
          "description": "Filter by tags (entries must have all specified tags)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tenant_id": {
          "description": "Tenant ID scope (defaults to current tenant)",
          "type": "string"
        },
        "trust_level": {
          "description": "Filter by trust level (system, learned, external)",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "conditional": false
  },
