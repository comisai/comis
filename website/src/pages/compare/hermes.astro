                <span class="text-teal text-xs font-bold">H</span>
              </div>
              <h3 class="text-lg font-bold text-white">{hermes.name}</h3>
            </div>
            <div class="space-y-3 text-muted-light">
              {
                hermes.quotes.map((q) => (
                  <blockquote class="border-l-2 border-teal/40 pl-4">
                    <p class="italic text-white">&ldquo;{q.text}&rdquo;</p>
                    <cite class="text-xs text-muted not-italic">
                      - {q.source}
                    </cite>
                  </blockquote>
                ))
              }
              <p>
                <span class="text-white font-medium">Design center:</span>{" "}
                {hermes.designCenter}
              </p>
              <p>
                <span class="text-white font-medium">Self-improvement:</span> A built-in
                learning loop - the agent creates and rewrites its own skills
                from experience.
              </p>
            </div>
          </div>
        </div>
      </div>
