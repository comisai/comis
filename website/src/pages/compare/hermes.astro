---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import { COMPETITORS, COMIS_WINS, COMPARE_CLOSE } from "../../data/competitors";
import { FACTS } from "../../data/facts";

const hermes = COMPETITORS.hermes;

const title = "Comis vs Hermes Agent - Deep Technical Comparison";
const description =
  "An honest, source-traceable comparison of Comis and Hermes Agent across design center, security, agent capabilities, context management, orchestration, and developer experience. Their strengths credited; their own documentation quoted verbatim.";

type Verdict = "comis" | "hermes" | "tie";
interface Row {
  label: string;
  comis: string;
  hermes: string;
  verdict: Verdict;
}

const designRows: Row[] = [
  {
    label: "Design center",
    comis:
      "Platform - many agents × many operators, one auditable install. Built from the premise that the agents and people sharing an install aren't all fully trusted.",
    hermes:
      "Single-tenant personal agent, by design. Host-first: one trusted operator on their own machine. (Their words: “Hermes Agent is a single-tenant personal agent.”)",
    verdict: "comis",
  },
  {
    label: "Trust model",
    comis:
      "Multi-tenant by construction: per-session routing, per-agent isolation, and trust-partitioned memory so an untrusted sender can't reach what the system verified.",
    hermes:
      "Single trust tier per gateway - all authorized callers are equally trusted; no per-caller capability model. The operating system is the security boundary.",
    verdict: "comis",
  },
  {
    label: "Typed errors end-to-end",
    comis:
      "Result<T, E> everywhere - ok(), err(), tryCatch(), fromPromise(). Failure is a value the compiler checks, not a stray exception.",
    hermes:
      "Traditional throw/catch error handling. Runtime-checked.",
    verdict: "comis",
  },
];

const securityRows: Row[] = [
  {
    label: "Exec sandbox",
    comis:
      "Kernel-enforced and on by default - Bubblewrap on Linux (full namespace unshare), sandbox-exec on macOS. Tools run jailed by the OS itself, not by a setting you have to remember to turn on; credentialed CLI spawns additionally run with no network (broker-only mode).",
    hermes:
      "Host-first by default. Containers confine the shell tool, not the agent. The agent process itself runs on the host.",
    verdict: "comis",
  },
  {
    label: "Secrets at rest",
    comis:
      "AES-256-GCM encrypted store. The code that builds the sandbox env never reads the real key.",
    hermes:
      "Plaintext .env plus file permissions, with Bitwarden as an opt-in source.",
    verdict: "comis",
  },
  {
    label: "API keys vs. agent runtime",
    comis:
      "Credential broker: the key is injected at the network boundary by an in-process MITM that terminates TLS with its own CA, validates a single-use token, and swaps a placeholder at the header layer. The key never enters the sandbox. Fails closed - any gate failure destroys the tunnel before a byte reaches upstream.",
    hermes:
      "Env-scrub blocklist for child processes - named secrets are stripped from the environment handed to spawned tools. The agent process itself still holds the keys to authenticate.",
    verdict: "comis",
  },
  {
    label: "Prompt injection",
    comis:
      "Layered runtime defenses with benchmarked poisoning resistance - a weighted, multi-pattern content scanner, output guarding, and trust-partitioned memory, measured in public rather than asserted.",
    hermes:
      "Heuristic wrapping of untrusted content. Hermes is candid that this is not a boundary: in their own words, “The only security boundary against an adversarial LLM is the operating system.”",
    verdict: "comis",
  },
  {
    label: "Skill / code safety",
    comis:
      "A skill content scanner screens every skill at load time (exec injection, exfiltration, XML breakout), plus ESLint-enforced security bans (no path.join, no process.env, no eval/new Function, no swallowed errors) and architecture-as-tests that block insecure patterns in CI.",
    hermes:
      "Skills are user-authored and trusted by the single operator; self-improving skills are created and rewritten by the agent. A 'Skills Guard' scans skill content for injection patterns at install, but it is a review aid, not an enforced boundary - operator review is the real control.",
    verdict: "comis",
  },
  {
    label: "Supply-chain integrity",
    comis:
      "Sigstore-attested releases (npm provenance via GitHub OIDC); all dependencies exact-pinned and workspace packages bundled.",
    hermes:
      "Sigstore-signed releases with exact-pinned dependencies.",
    verdict: "tie",
  },
];

const agentRows: Row[] = [
  {
    label: "Self-improvement",
    comis:
      "Self-improvement lives in memory, not code: the memory learns from use via a bounded, auditable tuner (with the trust weight structurally frozen). Skills stay operator-reviewed - the agent does not rewrite its own executable skills.",
    hermes:
      "Yes - the agent rewrites its own skills. A built-in learning loop creates skills from experience and improves them during use. This is a genuine, distinctive strength.",
    verdict: "hermes",
  },
  {
    label: "Messaging channels",
    comis:
      `${FACTS.channels} first-party channels: ${FACTS.channelList.join(", ")}.`,
    hermes:
      "20+ platform adapters - a broad, mature channel surface. Channel breadth is a real Hermes strength.",
    verdict: "hermes",
  },
  {
    label: "Multi-agent orchestration",
    comis:
      `Natural-language → DAG orchestration: ${FACTS.dagNodeTypes} node types (agent, debate, vote, refine, collaborate, map-reduce, human approval gate) with barrier modes, per-node budgets, and approval gates.`,
    hermes:
      "delegate_task spawns isolated subagents (flat by default - depth 1; opt-in max_spawn_depth with no hard ceiling), plus a kanban board for task tracking. Effective for personal task delegation; not a full graph engine.",
    verdict: "comis",
  },
  {
    label: "Memory",
    comis:
      `Trust-partitioned and benchmarked in public: SQLite + FTS5 + sqlite-vec hybrid recall (reciprocal rank fusion), trust-first contradiction resolution (system > learned > external), and learning from use behind a bounded tuner with the trust weight frozen. Measured ${FACTS.benchmarks.mem0Tie} head-to-head with mem0 (N=${FACTS.benchmarks.mem0TieN}), ${FACTS.benchmarks.controlDelta} over a full-context control, ${FACTS.benchmarks.onDeviceCost}.`,
    hermes:
      "Agent-curated memory: LLM-free FTS5 session search, plus LLM summarization and dialectic user modeling for cross-session recall. No trust levels in the memory store (skill sources do carry builtin/trusted/community tiers); the learning loop is unbenchmarked.",
    verdict: "comis",
  },
  {
    label: "Model providers",
    comis:
      `${FACTS.models}.`,
    hermes:
      "Wide model support via Nous Portal, OpenRouter, NovitaAI, NVIDIA NIM, OpenAI, and any OpenAI-compatible endpoint - swap models with one command, no lock-in.",
    verdict: "tie",
  },
  {
    label: "Interactive terminal control",
    comis:
      "Daemon-supervised interactive terminal driver: a real PTY fed into a headless emulator, governed like an MCP server (operator allowlist + per-entry sandbox scope), credential-agnostic. Drives interactive shells and AI-CLIs.",
    hermes:
      "No interactive terminal/PTY driver - the terminal tool runs one-shot or background commands, not a live interactive session.",
    verdict: "comis",
  },
  {
    label: "Execution & deployment backends",
    comis:
      "Runs as a supervised daemon (directly or via pm2); no serverless or scale-to-zero hosting story.",
    hermes:
      "Six execution backends (local, Docker, SSH, Modal, Daytona, Singularity); Modal and Daytona offer serverless persistence that hibernates when idle - a genuine operational strength.",
    verdict: "hermes",
  },
];

const contextRows: Row[] = [
  {
    label: "Context at scale",
    comis:
      "Lossless DAG context engine, on by default - nothing is deleted; old turns compress into a zoomable leaf→condensed summary DAG the agent can drill back into (ctx_search / ctx_inspect / ctx_expand). Compression you can reverse, not destruction you can't.",
    hermes:
      "Auto-compression at roughly 50% of the context window, using a cheaper model to summarize. Effective, but lossy - the compressed detail isn't recoverable in-session.",
    verdict: "comis",
  },
  {
    label: "Cache & cost optimization",
    comis:
      "A cache-fence index keeps the cached prefix byte-stable while the context engine edits everything after it, with adaptive TTL escalation, two-phase cache-break detection, and sub-agent spawn staggering - 15+ shipped optimizations. Measured 94% warm cache-hit rate; $5.02 vs $26.42 on a 76-call Opus session.",
    hermes:
      "Provider-level prompt caching where the model supports it. No published cache-fence, breakpoint, or systematic invalidation strategy.",
    verdict: "comis",
  },
  {
    label: "Local-model security floor & tuning",
    comis:
      "The security floor is a property of the platform, not the model: the kernel sandbox, credential broker, and skill content scanner apply identically whether you run a frontier cloud model or a local one (Ollama, vLLM, etc.) - the guarantees never depend on the model's goodwill. And the floor is only half of it: an immutable capability profile actively tunes Comis to the model - prompt-size budgets, focused tool sets, and deterministic tool selection so a small model isn't drowned in context it can't use, plus reliability rails (goal re-anchoring, a poison-resistant recall floor, tool-call JSON repair with self-correction, and reasoning models' chain-of-thought kept out of the reply). Weaker model, stricter lockdown and more scaffolding; capable models pay nothing for it.",
    hermes:
      "Local models are supported (Ollama, LM Studio, vLLM and similar). The OS is the boundary, whatever the model - there is no model-aware hardening.",
    verdict: "comis",
  },
];

const infraRows: Row[] = [
  {
    label: "Observability",
    comis:
      "Result<T, E> + traceId glass box: every action is reconstructable from structured logs alone (AsyncLocalStorage-propagated traceId, canonical field dictionary, required hint + errorKind on every failure branch), plus a bounded, causal obs.explain incident artifact.",
    hermes:
      "Python logging with rotating, credential-redacted plaintext logs per component (agent / gateway / gui). Solid operational logging for a single operator; no structured event bus.",
    verdict: "comis",
  },
  {
    label: "Architecture",
    comis:
      `Hexagonal (ports & adapters). ${FACTS.packages}-package monorepo with a compile-time-enforced dependency graph via TypeScript composite references.`,
    hermes:
      "Single gateway process with a plugin/skill model. Lighter-weight and quick to extend for one operator.",
    verdict: "comis",
  },
  {
    label: "License",
    comis:
      "Apache-2.0 - patent grant included.",
    hermes:
      "MIT - permissive and simple.",
    verdict: "tie",
  },
];

const allRows = [
  ...designRows,
  ...securityRows,
  ...agentRows,
  ...contextRows,
  ...infraRows,
];

const categories = [
  { name: "Design & Trust", rows: designRows },
  { name: "Security", rows: securityRows },
  { name: "Agent Capabilities", rows: agentRows },
  { name: "Context Management", rows: contextRows },
  { name: "Infrastructure & DX", rows: infraRows },
];

function count(rows: readonly Row[], v: Verdict) {
  return rows.filter((r) => r.verdict === v).length;
}

const totalComis = count(allRows, "comis");
const totalHermes = count(allRows, "hermes");
const totalTie = count(allRows, "tie");
// Derive the dimension count from the data (never hardcode the total).
const totalDimensions = allRows.length;

function verdictBadge(v: Verdict) {
  if (v === "comis") return { text: "Comis", cls: "bg-coral/20 text-coral" };
  if (v === "hermes") return { text: "Hermes", cls: "bg-teal/20 text-teal" };
  return { text: "Tie", cls: "bg-white/10 text-muted" };
}

const sectionThemes = [
  { accent: "coral", bg: "bg-navy-light/50" },
  { accent: "coral", bg: "" },
  { accent: "teal", bg: "bg-navy-light/50" },
  { accent: "coral", bg: "" },
  { accent: "purple", bg: "bg-navy-light/50" },
] as const;

const sectionMeta = [
  {
    title: "Design & Trust",
    subtitle: "A shared platform vs. a single-tenant personal agent.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  },
  {
    title: "Security",
    subtitle: "Kernel-enforced defense in depth vs. the OS as the boundary.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  },
  {
    title: "Agent Capabilities",
    subtitle: "Where Hermes's self-improving loop genuinely shines.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    title: "Context Management",
    subtitle: "Lossless, reversible compression vs. cheap-model summary.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`,
  },
  {
    title: "Infrastructure & DX",
    subtitle: "Glass-box observability and a typed, layered architecture.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
];
---

<Base title={title} description={description}>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-32 pb-12 md:pt-40 md:pb-16">
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute top-1/3 left-1/3 w-[400px] h-[400px] bg-coral/5 rounded-full blur-[120px]"
        ></div>
        <div
          class="absolute top-1/2 right-1/4 w-[300px] h-[300px] bg-teal/5 rounded-full blur-[120px]"
        ></div>
      </div>

      <div class="relative max-w-3xl mx-auto text-center">
        <p
          class="text-sm font-semibold text-muted uppercase tracking-widest mb-4"
        >
          Deep technical comparison
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]"
        >
          <span class="text-white">Comis</span>
          <span class="text-muted mx-2">vs</span>
          <span
            class="bg-gradient-to-r from-teal to-teal-dark bg-clip-text text-transparent"
            >Hermes</span
          >
        </h1>
        <p
          class="mt-6 text-lg md:text-xl text-muted max-w-2xl mx-auto leading-relaxed"
        >
          {totalDimensions} dimensions, both codebases reviewed. Hermes Agent
          (by Nous Research) is an excellent self-improving research agent. This
          is an honest, source-traceable look at where each one fits.
        </p>
        <p class="mt-3 text-sm text-muted/70">
          Both projects are open source. Quotes are verbatim from Hermes's own
          documentation; this comparison reflects the codebases as of June 2026.
        </p>
      </div>
    </section>

    <!-- Scorecard -->
    <section class="px-6 pb-16 md:pb-20">
      <div class="max-w-4xl mx-auto">
        <!-- Total scores -->
        <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto mb-10">
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-extrabold text-coral">
              {totalComis}
            </div>
            <div class="text-sm text-muted mt-1">Comis leads</div>
          </div>
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-extrabold text-teal">
              {totalHermes}
            </div>
            <div class="text-sm text-muted mt-1">Hermes leads</div>
          </div>
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-extrabold text-muted/60">
              {totalTie}
            </div>
            <div class="text-sm text-muted mt-1">Tied</div>
          </div>
        </div>

        <!-- Category breakdown -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
          {
            categories.map((cat) => (
              <div class="bg-navy-light/50 rounded-lg border border-white/5 p-4 text-center">
                <div class="text-xs text-muted uppercase tracking-wider mb-2 leading-tight">
                  {cat.name}
                </div>
                <div class="flex items-center justify-center gap-1.5 text-sm font-bold">
                  <span class="text-coral">{count(cat.rows, "comis")}</span>
                  <span class="text-muted/40">-</span>
                  <span class="text-teal">{count(cat.rows, "hermes")}</span>
                  <span class="text-muted/40">-</span>
                  <span class="text-muted/60">{count(cat.rows, "tie")}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Comparison sections -->
    {
      categories.map((cat, i) => {
        const theme = sectionThemes[i];
        const meta = sectionMeta[i];
        const accentText =
          theme.accent === "coral"
            ? "text-coral"
            : theme.accent === "teal"
              ? "text-teal"
              : theme.accent === "emerald"
                ? "text-emerald-400"
                : "text-purple-400";
        const accentBg =
          theme.accent === "coral"
            ? "bg-coral/20"
            : theme.accent === "teal"
              ? "bg-teal/20"
              : theme.accent === "emerald"
                ? "bg-emerald-500/20"
                : "bg-purple-500/20";

        return (
          <section class:list={["px-6 py-16 md:py-24", theme.bg]}>
            <div class="max-w-5xl mx-auto">
              <div class="flex items-center gap-3 mb-4">
                <div
                  class:list={[
                    "w-8 h-8 rounded-lg flex items-center justify-center",
                    accentBg,
                  ]}
                >
                  <svg
                    class:list={["w-4 h-4", accentText]}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    set:html={meta.icon}
                  />
                </div>
                <p
                  class:list={[
                    "font-semibold text-sm uppercase tracking-widest",
                    accentText,
                  ]}
                >
                  {meta.title}
                </p>
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                {meta.subtitle}
              </h2>

              <div class="space-y-5 mt-10">
                {cat.rows.map((r) => {
                  const badge = verdictBadge(r.verdict);
                  return (
                    <div class="bg-navy rounded-xl border border-white/5 overflow-hidden">
                      <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-white">
                          {r.label}
                        </h3>
                        <span
                          class:list={[
                            "text-xs font-semibold px-2.5 py-0.5 rounded-full",
                            badge.cls,
                          ]}
                        >
                          {badge.text}
                        </span>
                      </div>
                      <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-white/5">
                        <div
                          class:list={[
                            "px-6 py-5",
                            r.verdict === "hermes" ? "bg-teal/5" : "",
                          ]}
                        >
                          <p
                            class:list={[
                              "text-xs font-medium uppercase tracking-wider mb-2",
                              r.verdict === "hermes"
                                ? "text-teal"
                                : "text-muted",
                            ]}
                          >
                            Hermes
                          </p>
                          <p
                            class:list={[
                              "leading-relaxed",
                              r.verdict === "hermes"
                                ? "text-muted-light"
                                : "text-muted",
                            ]}
                          >
                            {r.hermes}
                          </p>
                        </div>
                        <div
                          class:list={[
                            "px-6 py-5",
                            r.verdict === "comis" ? "bg-coral/5" : "",
                          ]}
                        >
                          <p
                            class:list={[
                              "text-xs font-medium uppercase tracking-wider mb-2",
                              r.verdict === "comis"
                                ? "text-coral"
                                : "text-muted",
                            ]}
                          >
                            Comis
                          </p>
                          <p
                            class:list={[
                              "leading-relaxed",
                              r.verdict === "comis"
                                ? "text-muted-light"
                                : "text-muted",
                            ]}
                          >
                            {r.comis}
                          </p>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>
        );
      })
    }

    <!-- Key takeaways -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">
          Key takeaways
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Where Comis leads -->
          <div class="bg-navy-light/50 rounded-xl border border-coral/20 p-8">
            <h3 class="text-xl font-bold text-coral mb-6">Where Comis leads</h3>
            <ul class="space-y-4 text-muted-light">
              {
                COMIS_WINS.map((win) => (
                  <li class="flex gap-3">
                    <svg
                      class="w-5 h-5 text-coral flex-shrink-0 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <span>{win}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Where Hermes leads -->
          <div class="bg-navy-light/50 rounded-xl border border-teal/20 p-8">
            <h3 class="text-xl font-bold text-teal mb-6">Where Hermes leads</h3>
            <ul class="space-y-4 text-muted-light">
              {
                hermes.strengths.map((strength) => (
                  <li class="flex gap-3">
                    <svg
                      class="w-5 h-5 text-teal flex-shrink-0 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="font-semibold text-white">{strength}</span>
                  </li>
                ))
              }
              <li class="text-muted text-sm pt-2 border-t border-white/5">
                If you want a self-improving research agent that writes its own
                skills, Hermes is genuinely excellent at exactly that.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Different philosophies -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">
          Different philosophies
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="flex items-center gap-3 mb-2">
              <img src="/images/comis-logo.png" alt="Comis" class="h-6" />
              <h3 class="text-lg font-bold text-white">Comis</h3>
            </div>
            <div class="space-y-3 text-muted-light">
              <p>
                <span class="text-white font-medium">Design center:</span> A platform
                for whole teams, isolated by design - many agents, many operators,
                one auditable install.
              </p>
              <p>
                <span class="text-white font-medium">Security stance:</span> Defense
                in depth, enforced by the kernel and the compiler - not by prompts.
                Sandbox on by default; keys never meet the agent.
              </p>
              <p>
                <span class="text-white font-medium">Self-improvement:</span> In
                memory, not code - the memory learns from use under a bounded,
                auditable tuner; skills stay operator-reviewed.
              </p>
              <p>
                <span class="text-white font-medium">Trust model:</span> Multi-tenant
                ready, with trust-partitioned memory and per-session routing.
              </p>
            </div>
          </div>

          <div class="space-y-6">
            <div class="flex items-center gap-3 mb-2">
              <div
                class="w-6 h-6 rounded bg-teal/20 flex items-center justify-center"
