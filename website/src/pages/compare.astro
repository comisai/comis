---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { FACTS } from "../data/facts";
import { COMPETITORS, COMIS_WINS, COMPARE_CLOSE } from "../data/competitors";

const title = "How Comis compares - OpenClaw, Hermes, and the honest case for Comis";
const description =
  "We built Comis after studying its two closest neighbors in depth. Both are excellent. Here is what each is for, in their own words, and where Comis differs - sourced from each project's own documentation.";

const { openclaw, hermes } = COMPETITORS;

// The README §How Comis compares table, mirrored. Each cell is sourced from the
// project's own repo / security docs (June 2026). Counted facts come from the
// data layer so they can never drift from the rest of the site.
interface CompareRow {
  dimension: string;
  comis: string;
  openclaw: string;
  hermes: string;
}

const compareRows: CompareRow[] = [
  {
    dimension: "Design center",
    comis: "Platform - many agents x many operators, one auditable install",
    openclaw: "Personal assistant - one trusted operator, by design",
    hermes: "Single-tenant personal agent, by design",
  },
  {
    dimension: "Exec sandbox",
    comis: "Configured by default; kernel-backed where supported (Bubblewrap / sandbox-exec)",
    openclaw: "Docker sandbox, opt-in (off by default)",
    hermes: "Host-first by default; containers confine the shell tool, not the agent",
  },
  {
    dimension: "Secrets at rest",
    comis: "AES-256-GCM encrypted store",
    openclaw: "Config/auth profiles support plaintext paths and SecretRefs",
    hermes: ".env + file permissions (Bitwarden opt-in)",
  },
  {
    dimension: "API keys vs. agent runtime",
    comis: "Credential broker - key injected at the network boundary, never inside the sandbox",
    openclaw: "Keys held in the gateway process",
    hermes: "Env-scrub blocklist for child processes",
  },
  {
    dimension: "Prompt injection",
    comis: "Layered runtime defenses + benchmarked poisoning resistance",
    openclaw: "Out of scope absent a boundary bypass",
    hermes: "Heuristic wrapping; no boundary claimed",
  },
  {
    dimension: "Memory",
    comis: "Trust-partitioned, learns from use (bounded tuner, trust frozen), benchmarked in public",
    openclaw: "No trust levels",
    hermes: "No trust levels; learning loop unbenchmarked",
  },
  {
    dimension: "Context at scale",
    comis: "DAG-backed context recovery - compressed detail remains inspectable in-session",
    openclaw: "Compaction / pruning hooks; tool-result compaction",
    hermes: "Auto-compression at 50% of window (cheap-model summary)",
  },
  {
    dimension: "Local models",
    comis: "Tier-aware capability profile - a weaker model gets a stricter security posture and an auto-tuned reliability scaffold (prompt-size caps, focused tool sets, JSON repair, self-correction)",
    openclaw: "Supported (Ollama, LM Studio, vLLM); no model-aware hardening",
    hermes: "Supported (Ollama, LM Studio, vLLM); the OS is the boundary, whatever the model",
  },
  {
    dimension: "Multi-agent orchestration",
    comis: `Natural-language DAGs - ${FACTS.dagNodeTypes} node types, barriers, budgets, approval gates`,
    openclaw: "Agent routing + spawn; hierarchy frameworks declined",
    hermes: "delegate_task (depth <= 2) + kanban board",
  },
  {
    dimension: "Typed errors end-to-end",
    comis: "Result<T, E> first - failures are typed and architecture-tested",
    openclaw: "-",
    hermes: "-",
  },
  {
    dimension: "Messaging channels",
    comis: `${FACTS.channels}`,
    openclaw: openclaw.channels,
    hermes: hermes.channels,
  },
  {
    dimension: "Self-improvement",
    comis: "In memory, not code - the memory learns from use (bounded, auditable); skills stay operator-reviewed",
    openclaw: "-",
    hermes: "Yes - agent rewrites its own skills",
  },
  {
    dimension: "License",
    comis: "Apache-2.0",
    openclaw: "MIT",
    hermes: "MIT",
  },
];
---

<Base title={title} description={description}>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-32 pb-16 md:pt-40 md:pb-20">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-coral/5 rounded-full blur-[120px]"></div>
      </div>

      <div class="relative max-w-3xl mx-auto text-center">
        <a href="/" class="inline-flex items-center gap-1 text-sm text-muted hover:text-teal transition-colors mb-8">
          &larr; Back to Home
        </a>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
          How Comis compares.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
          We built Comis after studying its two closest neighbors in depth -
          <a href={openclaw.repo} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors">OpenClaw</a>
          and
          <a href={hermes.repo} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors">Hermes Agent</a>.
          Both are excellent, and both are candid about their design center. So are we.
        </p>
        <p class="mt-8 text-lg md:text-xl text-white font-medium max-w-2xl mx-auto leading-relaxed">
          Comis starts from the opposite premise: <span class="text-teal">an install that holds up even when the agents and people sharing it aren't fully trusted.</span>
        </p>
      </div>
    </section>

    <!-- The two neighbors, credited honestly -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">In their own words</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Two great agents, built for one trusted operator.
        </h2>
        <p class="text-muted text-lg mb-12 max-w-2xl leading-relaxed">
          Neither is a strawman. Each is a serious, well-engineered project with a clearly stated design center. Here is what each does best - and exactly how its authors describe its security model.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          {[openclaw, hermes].map((c) => (
            <div class="bg-navy rounded-xl border border-white/5 overflow-hidden flex flex-col">
              <div class="px-6 py-5 border-b border-white/5">
                <h3 class="text-xl font-bold text-white">{c.name}</h3>
                <p class="text-muted text-sm mt-1">{c.designCenter}</p>
              </div>
              <div class="px-6 py-5">
                <p class="text-xs font-medium text-teal uppercase tracking-wider mb-3">Where it shines</p>
                <ul class="space-y-2 mb-6">
                  {c.strengths.map((s) => (
                    <li class="flex items-start gap-2 text-muted-light text-sm">
                      <svg class="w-4 h-4 text-teal shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      <span class="font-semibold text-white">{s}</span>
                    </li>
                  ))}
                </ul>
                <p class="text-xs font-medium text-muted uppercase tracking-wider mb-3">From their own docs</p>
                <ul class="space-y-3">
                  {c.quotes.map((q) => (
                    <li class="border-l-2 border-white/10 pl-3">
                      <p class="text-muted italic text-sm leading-relaxed">&ldquo;{q.text}&rdquo;</p>
                      <p class="text-muted text-xs mt-1">- {q.source}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Where Comis differs -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-5xl mx-auto">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">Where Comis differs</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Designed for a shared install from day one.
        </h2>
        <p class="text-muted text-lg mb-12 max-w-2xl leading-relaxed">
          OpenClaw and Hermes are built around one trusted operator. Comis is built for a team, family, or company - many agents and operators sharing one install - so separation, secret handling, and auditability are platform properties, not prompt instructions.
        </p>

        <div class="grid md:grid-cols-2 gap-x-8 gap-y-4">
          {COMIS_WINS.map((win) => (
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-coral shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <p class="text-muted-light leading-relaxed">{win}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Side-by-side table (mirrors README §How Comis compares) -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Side by side</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          The full picture.
        </h2>
        <p class="text-muted text-lg mb-12 max-w-2xl leading-relaxed">
          Sourced from each project's own repository and security documentation, June 2026. Their strengths are <span class="text-white font-semibold">bolded where they win</span>.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th scope="col" class="py-3 pr-4 text-sm font-medium text-muted whitespace-nowrap"></th>
                <th scope="col" class="py-3 px-4 text-sm font-semibold text-coral">Comis</th>
                <th scope="col" class="py-3 px-4 text-sm font-medium text-muted">{openclaw.name}</th>
                <th scope="col" class="py-3 pl-4 text-sm font-medium text-muted">{hermes.name}</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map((r) => (
                <tr class="border-b border-white/5 align-top">
                  <th scope="row" class="py-4 pr-4 text-sm font-medium text-white whitespace-nowrap text-left">{r.dimension}</th>
                  <td class="py-4 px-4 text-sm text-muted-light max-w-[260px]">{r.comis}</td>
                  <td class="py-4 px-4 text-sm text-muted max-w-[220px]">
                    {r.dimension === "Messaging channels" || r.dimension === "Self-improvement"
                      ? <span class="text-white font-semibold">{r.openclaw}</span>
                      : r.openclaw}
                  </td>
                  <td class="py-4 pl-4 text-sm text-muted max-w-[220px]">
                    {r.dimension === "Messaging channels" || r.dimension === "Self-improvement"
                      ? <span class="text-white font-semibold">{r.hermes}</span>
                      : r.hermes}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deep comparisons -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 text-center">
          Want the full side-by-side?
        </h2>
        <p class="text-muted text-lg mb-12 text-center max-w-xl mx-auto">
          Each deep comparison is a verified, dimension-by-dimension walkthrough across architecture, security, capabilities, context, and cost.
        </p>

        <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
          <a href="/compare/openclaw" class="group bg-navy-light/80 border border-white/5 hover:border-teal/30 rounded-xl p-6 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-1">Comis vs {openclaw.name}</h3>
            <p class="text-muted text-sm mb-4">A verified, dimension-by-dimension technical comparison.</p>
            <span class="inline-flex items-center gap-1 text-teal text-sm font-medium group-hover:gap-2 transition-all">Read the deep comparison &rarr;</span>
          </a>
          <a href="/compare/hermes" class="group bg-navy-light/80 border border-white/5 hover:border-teal/30 rounded-xl p-6 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-1">Comis vs {hermes.name}</h3>
            <p class="text-muted text-sm mb-4">A verified, dimension-by-dimension technical comparison.</p>
            <span class="inline-flex items-center gap-1 text-teal text-sm font-medium group-hover:gap-2 transition-all">Read the deep comparison &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Choose honestly -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Choose honestly</p>
        <p class="text-xl md:text-2xl text-white leading-relaxed">
          {COMPARE_CLOSE}
        </p>

        <div class="flex flex-wrap gap-4 justify-center mt-12">
          <a href="/#quick-start" class="inline-flex items-center justify-center px-8 py-3.5 bg-coral-btn hover:bg-coral-btn-hover text-white font-semibold rounded-lg transition-colors text-lg">
            Get Started
          </a>
          <a href="https://docs.comis.ai" rel="noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-8 py-3.5 bg-white/10 hover:bg-white/15 text-white font-semibold rounded-lg transition-colors text-lg border border-white/10">
            Read the docs
          </a>
          <a href="https://github.com/comisai/comis" rel="noopener noreferrer" target="_blank" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white/10 hover:bg-white/15 text-white font-semibold rounded-lg transition-colors text-lg border border-white/10">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            View on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
