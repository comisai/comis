---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { FACTS } from "../data/facts";

const title = "Contribute - built to be contributed to, safely";
const description =
  "Comis is built to be contributed to: the rules are executable (pnpm validate runs the same gates as CI), the protocol is written down (AGENTS.md), and every extension point is a real, typed interface. Here's how to land your first change.";

const agentsMdUrl = `${FACTS.links.github}/blob/main/AGENTS.md`;
const discussionsUrl = `${FACTS.links.github}/discussions`;
const issuesUrl = `${FACTS.links.github}/issues`;
// The good-first-issue funnel link is the single-source-of-truth
// FACTS.links.goodFirstIssue - the GitHub issues view filtered by the
// label:"good+first+issue" query. Surfaced here so the link contract is
// explicit at the call site.
const goodFirstIssueUrl = FACTS.links.goodFirstIssue;

// What contributing means, in plain language, before any command appears.
const pillars = [
  {
    title: "The rules are executable",
    body: "One command - pnpm validate - runs the exact gates CI does: a clean build, dependency-cycle checks, the security lint, and per-package coverage floors. You find out before you push, not after a reviewer does. No guessing what “good” looks like.",
    code: "pnpm validate",
  },
  {
    title: "The protocol is written down",
    body: "AGENTS.md is the engineering contract - Result<T, E> for errors, tests-first, the security rules, the naming and logging conventions. There's no tribal knowledge to absorb and no maintainer you have to ping to learn “how we do things here.”",
    code: null,
  },
  {
    title: "Extension points are real interfaces",
    body: "Adding to Comis means implementing a typed port, not patching a monolith. A new chat channel is a ChannelPort. A new tool is a manifest plus a handler. A new backend (a model provider, a store) is a port adapter. The compiler tells you when you've implemented it correctly.",
    code: null,
  },
];

// Where help lands hardest (README Contributing).
const helpAreas = [
  {
    name: "Channel adapters",
    body: `New messaging platforms beyond the ${FACTS.channels} we ship today - implement ChannelPort and wire it into the composition root.`,
  },
  {
    name: "Skills & MCP integrations",
    body: "New built-in tools (a manifest + handler) or integrations with the MCP ecosystem - 50+ servers exist; you choose which to wire in.",
  },
  {
    name: "Docs",
    body: "Clear, accurate documentation is a force multiplier - and a great first contribution. If a page is wrong or missing, fixing it counts.",
  },
];
---

<Base title={title} description={description}>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-32 pb-12 md:pt-40 md:pb-16">
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-coral/5 rounded-full blur-[120px]"
        ></div>
      </div>
      <div class="relative max-w-3xl mx-auto text-center">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-muted hover:text-coral transition-colors mb-8"
        >
          &larr; Back to Home
        </a>
        <p
          class="text-coral font-semibold text-sm uppercase tracking-widest mb-4"
        >
          Open source &amp; Apache-2.0
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white"
        >
          Built to be contributed to - safely.
        </h1>
        <p
          class="mt-6 text-lg md:text-xl text-muted max-w-2xl mx-auto leading-relaxed"
        >
          Comis is a security-first platform, which usually means contributing is
          intimidating. We built it so it isn't: the rules run as a command, the
          engineering protocol is written down, and every place you'd extend is a
          real, typed interface. You can land a change with confidence on your
          first try.
        </p>
        <div class="mt-10 flex flex-wrap gap-4 justify-center">
          <a
            href={goodFirstIssueUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-coral-btn hover:bg-coral-btn-hover text-white font-semibold rounded-lg transition-colors text-lg"
          >
            Good first issue &rarr;
          </a>
          <a
            href={FACTS.links.github}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white/10 hover:bg-white/15 text-white font-semibold rounded-lg transition-colors text-lg border border-white/10"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
            View on GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- Three pillars: why contributing here is safe -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">
          Why it's safe to contribute
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-12">
          Safety is in the architecture, not in a checklist.
        </h2>

        <div class="space-y-6">
          {
            pillars.map((p) => (
              <div class="bg-navy rounded-xl border border-white/5 p-8">
                <h3 class="text-xl font-bold text-white mb-3">{p.title}</h3>
                <p class="text-muted-light leading-relaxed">{p.body}</p>
                {p.code && (
                  <pre class="mt-5 p-4 rounded-lg bg-navy-light/70 border border-white/5 text-sm md:text-base font-mono overflow-x-auto"><code><span class="text-coral">$</span> <span class="text-teal">{p.code}</span></code></pre>
                )}
                {p.title === "The protocol is written down" && (
                  <a
                    href={agentsMdUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center gap-1 mt-5 text-coral hover:text-coral-btn-hover font-medium transition-colors"
                  >
                    Read AGENTS.md &rarr;
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Get the code running -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">
          Get it running
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Three commands to a working checkout.
        </h2>
        <p class="text-muted text-lg mb-8 leading-relaxed">
          Comis is a TypeScript monorepo. Clone it, install the workspace, build,
          and run the tests - you're ready to make a change. Node.js {FACTS.nodeEngines} and
          pnpm are the only prerequisites.
        </p>

        <div class="bg-navy rounded-xl border border-white/5 overflow-hidden">
          <pre class="p-6 text-sm md:text-base font-mono leading-relaxed overflow-x-auto"><code><span class="text-muted-light"># 1. Clone</span>
<span class="text-coral">$</span> <span class="text-teal">git clone https://github.com/comisai/comis.git</span>

<span class="text-muted-light"># 2. Install + build the workspace</span>
<span class="text-coral">$</span> <span class="text-teal">cd comis && pnpm install && pnpm build</span>

<span class="text-muted-light"># 3. Run the tests + the security lint</span>
<span class="text-coral">$</span> <span class="text-teal">pnpm test && pnpm lint:security</span></code></pre>
        </div>
      </div>
    </section>

    <!-- Where help lands hardest -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">
          Where help lands hardest
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-12">
          The highest-leverage places to start.
        </h2>

        <div class="grid md:grid-cols-3 gap-6">
          {
            helpAreas.map((area) => (
              <div class="bg-navy rounded-xl border border-white/5 p-6">
                <h3 class="text-lg font-bold text-white mb-3">{area.name}</h3>
                <p class="text-muted-light leading-relaxed text-sm">
                  {area.body}
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-10 text-center">
          <a
            href={goodFirstIssueUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center gap-2 text-coral hover:text-coral-btn-hover font-semibold text-lg transition-colors"
          >
            Browse good first issues &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- The flow -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">
          The flow
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-8">
          Fork, branch, validate, PR.
        </h2>
        <div
          class="flex flex-wrap items-center justify-center gap-3 text-muted-light text-lg"
        >
          <span class="px-4 py-2 rounded-lg bg-navy-light/70 border border-white/5"
            >Fork</span
          >
          <span class="text-coral">&rarr;</span>
          <span class="px-4 py-2 rounded-lg bg-navy-light/70 border border-white/5"
            >branch <code class="text-teal text-base">feature/your-change</code></span
          >
          <span class="text-coral">&rarr;</span>
          <span class="px-4 py-2 rounded-lg bg-navy-light/70 border border-white/5"
            ><code class="text-teal text-base">pnpm validate</code></span
          >
          <span class="text-coral">&rarr;</span>
          <span class="px-4 py-2 rounded-lg bg-navy-light/70 border border-white/5"
            >PR against <code class="text-teal text-base">main</code></span
          >
        </div>
        <p class="mt-8 text-muted leading-relaxed max-w-xl mx-auto">
          A green <code class="text-teal">pnpm validate</code> means your PR passes
          the same deterministic gates CI will run - so review is about the idea,
          not the plumbing.
        </p>
      </div>
    </section>

    <!-- Community -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">
          Community
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Come say hello.
        </h2>
        <p class="text-muted text-lg mb-12 max-w-xl mx-auto">
          Questions, ideas, or just want to share what you built? Find us here.
        </p>

        <div class="grid sm:grid-cols-3 gap-6">
          <a
            href={FACTS.links.discord}
            rel="noopener noreferrer"
            target="_blank"
            class="bg-navy rounded-xl border border-white/5 hover:border-coral/30 p-6 transition-colors"
          >
            <h3 class="text-lg font-bold text-white mb-1">Discord</h3>
            <p class="text-muted text-sm">Chat with the community in real time.</p>
          </a>
          <a
            href={discussionsUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="bg-navy rounded-xl border border-white/5 hover:border-coral/30 p-6 transition-colors"
          >
            <h3 class="text-lg font-bold text-white mb-1">GitHub Discussions</h3>
            <p class="text-muted text-sm">Ask questions and propose ideas.</p>
          </a>
          <a
            href={issuesUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="bg-navy rounded-xl border border-white/5 hover:border-coral/30 p-6 transition-colors"
          >
            <h3 class="text-lg font-bold text-white mb-1">Issues</h3>
            <p class="text-muted text-sm">Report a bug or pick up a task.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Try it first (connects understand -> try -> contribute) -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Haven't run it yet?
        </h2>
        <p class="text-muted text-lg mb-10 max-w-xl mx-auto">
          The fastest way to find something worth contributing is to use Comis
          first. The one-line installer gets you there quickly on macOS and Linux.
        </p>
        <a
          href="/#quick-start"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-coral-btn hover:bg-coral-btn-hover text-white font-semibold rounded-lg transition-colors text-lg"
        >
          Try it first &rarr;
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
