---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";

const title = "Memory benchmark — measured, reproducible, honest";
const description =
  "Comis agent-memory results measured at $0 and cross-judged, every number linked to its committed run manifest.";

// The GitHub tree the manifest links point at (the run dirs are committed under benchmarks/results/).
const repoTree = "https://github.com/comisai/comis/tree/main";
// The full methodology + reproduction page (docs site, Mintlify).
const methodologyUrl = "https://docs.comis.ai/agents/memory-benchmarks";

// --- ACCURACY (set A — cross-judged) ----------------------------------------
// Every row sourced from benchmarks/CLAIMS.md -> the j1-baseline manifest.
// Cross-MODEL (gpt-4o + gpt-4.1), graded by two independent judges.
const baselineManifest = "benchmarks/results/2026-05-31-j1-baseline";
const accuracyRows = [
  {
    metric: "Overall (n=135)",
    judgeA: "71.1",
    judgeB: "73.3",
    note: "spread 2.2 · stable",
    manifest: baselineManifest,
  },
  {
    metric: "knowledge-update (n=20)",
    judgeA: "75.0",
    judgeB: "75.0",
    note: "stable",
    manifest: baselineManifest,
  },
  {
    metric: "multi-session (n=20)",
    judgeA: "60.0",
    judgeB: "65.0",
    note: "stable",
    manifest: baselineManifest,
  },
  {
    metric: "temporal-reasoning (n=20)",
    judgeA: "45.0",
    judgeB: "40.0",
    note: "stable · weakest",
    manifest: baselineManifest,
  },
  {
    metric: "retrieval recall@5",
    judgeA: "0.845",
    judgeB: "—",
    note: "full-set · vector lane + on-device rerank",
    manifest: baselineManifest,
  },
];

// --- COST / LATENCY (judge-A run) -------------------------------------------
const costLatency = {
  tokensPerQuery: "~15.5k",
  p50: "6.25s",
  p95: "9.97s",
  manifest: baselineManifest,
};

// --- MECHANICAL deltas (sets B/D — keyless, $0) -----------------------------
// A SEPARATE panel. These are STRUCTURAL gate deltas measured keyless at $0 —
// NOT end-to-end QA-accuracy lifts. Never blended into the accuracy table.
const mechanicalDeltas = [
  {
    name: "Graph-spread lane (KG)",
    delta: "linked-doc recall OFF 0 → ON 1",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase100-kg/graph-spread-contribution-report.json",
  },
  {
    name: "MMR diversity (IQ)",
    delta: "diverse-doc rank OFF 3 → ON 2",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase102-iq/mmr-diversity-report.json",
  },
];

// --- What the new tracks provably do (keyless, $0) — SEPARATE from accuracy --
// Six capabilities shipped + proven keyless at $0. Each row is a STRUCTURAL
// invariant of the shipped code, NOT an end-to-end QA-accuracy lift, and is kept
// out of the accuracy table on purpose. The ask-your-memory row cites the
// gate-safe consolidated re-prove capstone (the per-track manifest dir slug
// itself names a forbidden marketing token). The one measured learning signal is
// a recall-SCORE lift; the costed competitor comparison is the deferred re-run.
const v29Capabilities = [
  {
    name: "Learning-to-rank (trust frozen)",
    delta: "bandit recall-SCORE lift +0.1 over 5 episodes (rank position flat on the keyless lane)",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase111-learn-rank/claim1-bandit-rank-lift-report.json",
  },
  {
    name: "Principled ranking decay",
    delta: "old/unused memory factor 0.553 < fresh 0.995 (decay ranks, never gates; byte-identical at neutral)",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase112-forget/claim2-deterministic-decay-report.json",
  },
  {
    name: "Per-user profile",
    delta: "typed per-user records round-trip 4/4; an external-trust upsert is rejected (0 rows); (tenant, agent, user) isolation; recall stays LLM-free",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase107-user/claim1-prefix-typing-report.json",
  },
  {
    name: "Per-channel relationship model (dormant / default-off)",
    delta: "directional A→B and B→A as two distinct edges; the sign-off gate holds (enabled-but-unsigned ⇒ 0 reads)",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase108-social/claim4-signoff-gate-report.json",
  },
  {
    name: "Ask-your-memory tool (opt-in / default-off)",
    delta: "recall stays LLM-free (0 model calls on read); citations are a subset of the recalled ids; mandatory abstention on empty recall",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase113-reprove/GATE-REPORT.md",
  },
  {
    name: "Query-conditional usefulness reorder",
    delta: "a memory used for intent X ranks 1 vs 2 for an X- vs Y-query (perIntentRankLift 1); citation→FEED accrual",
    label: "mechanical, keyless, $0 — not a QA-accuracy lift",
    manifest:
      "benchmarks/results/2026-06-01-phase110-learn-iq/claim1-per-intent-bucket-report.json",
  },
];

// --- COMPETITIVE HEAD-TO-HEAD (the costed re-run, finally measured) ---------
// accuracy, cross-judged — the SECOND real QA-accuracy set after the measured
// baseline. Competitors re-run by US under one protocol (answer claude-sonnet-4-6
// + judges gpt-4o AND claude, cross-judge spread 0.0 on every cell), best-effort
// N=8. Every cell read from the phase114-prove2 manifest. Binding framing:
// Comis TIED mem0 — the framing is "competitive-with mem0 / at-$0-on-device",
// NEVER a superiority claim. The differentiator is cost/latency/locality, not quality.
const h2hManifest = "benchmarks/results/2026-06-02-phase114-prove2";
const competitiveHeadToHead = {
  manifest: h2hManifest,
  intro:
    "On 8 LongMemEval questions, cross-judged by two independent models (gpt-4o + claude, spread 0.0 on every cell), Comis's LLM-free $0 on-device recall scores the same as mem0 — and both clear a full-context-dump control by +37.5 pt. At this best-effort N=8 the two are statistically indistinguishable, so Comis is competitive with mem0 at $0 on-device; the difference is production economics, not answer quality.",
  rows: [
    {
      system: "Comis (as-shipped recall)",
      judge1: "87.5% (7/8)",
      judge2: "87.5%",
      note: "LLM-free recall, $0 on-device",
    },
    {
      system: "mem0 (mem0ai 2.0.4, re-run by us)",
      judge1: "87.5% (7/8)",
      judge2: "87.5%",
      note: "paid LLM fact-extraction at ingest (~53 min / 8 items)",
    },
    {
      system: "letta-fs control (full-haystack dump)",
      judge1: "50.0% (4/8)",
      judge2: "50.0%",
      note: "the honesty anchor",
    },
  ],
  // measure-first per-capability QA-lift (N=50 mix) — also from the same manifest.
  capabilityNote:
    "Per-capability QA-lift (N=50 mix, cross-judged): Comis baseline 98.0% / 94.0% (spread 4.0, survives); the two recall-config capabilities are byte-identical to baseline on all 50 questions → +0.0 pt measured lift. No recall-config capability showed a measured QA-lift — the measure-first outcome.",
  scopeNote:
    "N=8 / N=50 are best-effort operator-costed samples, not the definitive scale. Zep / Hindsight / Mnemosyne were skip-with-disclosure (not wired this run) — never a fabricated cell. Comis TIED mem0: competitive-with, never a superiority claim.",
};

// --- HEAD-TO-HEAD (reproduce/extend via the gate — NO fabricated cell) ------
const headToHead = {
  command: "scripts/bench-memory.sh gate",
  copy:
    "The competitor head-to-head above is the operator-costed re-run, measured best-effort at N=8. The gate is how you extend it — a larger N, or the skip-with-disclosure competitors (Zep / Hindsight / Mnemosyne). We will not print a number we have not measured.",
  coi:
    "Comis authored this benchmark. Vendor-reported numbers are non-comparable across protocols; competitors are invited to reproduce on their own harness.",
};
---

<Base title={title} description={description}>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-32 pb-12 md:pt-40 md:pb-16">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-teal/5 rounded-full blur-[120px]"></div>
      </div>
      <div class="relative max-w-3xl mx-auto text-center">
        <a href="/" class="inline-flex items-center gap-1 text-sm text-muted hover:text-teal transition-colors mb-8">
          &larr; Back to Home
        </a>
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Measured at $0</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
          Accuracy, cross-judged — every number linked to its run manifest
        </h1>
        <p class="mt-6 text-lg md:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
          The numbers below were graded by two independent LLM judges (gpt-4o + gpt-4.1) under one
          disclosed protocol. Each one links to the committed run that produced it — nothing here is
          asserted, and there is no placeholder.
        </p>
      </div>
    </section>

    <!-- Accuracy (set A — cross-judged) -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Accuracy, cross-judged</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">The measured baseline</h2>
        <p class="text-muted text-lg mb-10 max-w-2xl leading-relaxed">
          These are Comis's only end-to-end QA-accuracy numbers — scored by two judges and reported
          only where the cross-judge spread is stable.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-white/10">
                <th scope="col" class="py-3 pr-6 text-sm font-medium text-muted">Metric</th>
                <th scope="col" class="py-3 px-6 text-sm font-semibold text-teal">Judge A (gpt-4o)</th>
                <th scope="col" class="py-3 px-6 text-sm font-semibold text-teal">Judge B (gpt-4.1)</th>
                <th scope="col" class="py-3 px-6 text-sm font-medium text-muted">Notes</th>
                <th scope="col" class="py-3 pl-6 text-sm font-medium text-muted">Manifest</th>
              </tr>
            </thead>
            <tbody>
              {accuracyRows.map((r) => (
                <tr class="border-b border-white/5">
                  <th scope="row" class="py-3 pr-6 text-sm font-medium text-white whitespace-nowrap text-left">{r.metric}</th>
                  <td class="py-3 px-6 text-sm text-muted-light font-mono">{r.judgeA}</td>
                  <td class="py-3 px-6 text-sm text-muted-light font-mono">{r.judgeB}</td>
                  <td class="py-3 px-6 text-sm text-muted">{r.note}</td>
                  <td class="py-3 pl-6 text-sm">
                    <a href={`${repoTree}/${r.manifest}`} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors font-mono">manifest &rarr;</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-muted text-sm mt-6 leading-relaxed max-w-3xl">
          QA accuracy is on a disclosed 135-item category-stratified subset; retrieval recall@5 is
          full-set. Judges are cross-<strong class="text-muted-light">model</strong> (gpt-4o + gpt-4.1),
          not cross-provider. single-session-preference is omitted — judge-noisy, 15pt spread;
          LoCoMo is comparability-only and is never headlined.
        </p>
      </div>
    </section>

    <!-- Cost & latency -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Cost &amp; latency</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">What a query costs</h2>
        <div class="bg-navy-light/80 border border-teal/15 rounded-xl p-6 md:p-8">
          <div class="grid md:grid-cols-3 gap-8 text-center">
            <div>
              <p class="text-3xl font-bold text-teal font-mono">{costLatency.tokensPerQuery}</p>
              <p class="text-muted text-sm mt-2">tokens / query</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-teal font-mono">{costLatency.p50}</p>
              <p class="text-muted text-sm mt-2">latency P50</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-teal font-mono">{costLatency.p95}</p>
              <p class="text-muted text-sm mt-2">latency P95</p>
            </div>
          </div>
          <p class="text-center mt-6">
            <a href={`${repoTree}/${costLatency.manifest}`} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors font-mono text-sm">manifest (GAP-REPORT) &rarr;</a>
          </p>
        </div>
      </div>
    </section>

    <!-- What the mechanical tracks provably do (keyless, $0) — SEPARATE from accuracy -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Keyless, at $0</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">What the mechanical tracks provably do</h2>
        <p class="text-muted text-lg mb-10 max-w-2xl leading-relaxed">
          These are <strong class="text-muted-light">structural</strong> gate deltas — measured with no
          answer model, no judge, no key, at $0. They are <strong class="text-muted-light">not</strong>
          end-to-end QA-accuracy lifts, and they are kept out of the accuracy table above on purpose.
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          {mechanicalDeltas.map((m) => (
            <div class="bg-navy border border-teal/15 rounded-xl p-6">
              <h3 class="text-white font-semibold mb-2">{m.name}</h3>
              <p class="text-muted-light font-mono text-sm mb-3">{m.delta}</p>
              <p class="text-muted text-xs italic mb-4">({m.label})</p>
              <a href={`${repoTree}/${m.manifest}`} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors font-mono text-sm">manifest &rarr;</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What the newer tracks provably do (keyless, $0) — SEPARATE from accuracy -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Keyless, at $0</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">What the newer tracks provably do</h2>
        <p class="text-muted text-lg mb-10 max-w-2xl leading-relaxed">
          Six capabilities Comis now ships — each proven with no answer model, no judge, no key, at
          $0. As above, these are <strong class="text-muted-light">structural</strong> invariants,
          <strong class="text-muted-light">not</strong> end-to-end QA-accuracy lifts; the one
          measured learning signal is a recall-<strong class="text-muted-light">score</strong> lift,
          and the costed competitor comparison is the operator-costed re-run below.
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          {v29Capabilities.map((m) => (
            <div class="bg-navy-light/80 border border-teal/15 rounded-xl p-6">
              <h3 class="text-white font-semibold mb-2">{m.name}</h3>
              <p class="text-muted-light font-mono text-sm mb-3">{m.delta}</p>
              <p class="text-muted text-xs italic mb-4">({m.label})</p>
              <a href={`${repoTree}/${m.manifest}`} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors font-mono text-sm">manifest &rarr;</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- competitive head-to-head — the costed re-run, finally measured -->
    <section class="px-6 py-16 md:py-24 bg-navy-light/50">
      <div class="max-w-5xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Competitive head-to-head · cross-judged</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Competitive with mem0 — at $0 on-device</h2>
        <p class="text-muted text-lg mb-10 max-w-3xl leading-relaxed">{competitiveHeadToHead.intro}</p>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-white/10">
                <th scope="col" class="py-3 pr-6 text-sm font-medium text-muted">System</th>
                <th scope="col" class="py-3 px-6 text-sm font-semibold text-teal">Judge 1 (gpt-4o)</th>
                <th scope="col" class="py-3 px-6 text-sm font-semibold text-teal">Judge 2 (claude)</th>
                <th scope="col" class="py-3 pl-6 text-sm font-medium text-muted">Note</th>
              </tr>
            </thead>
            <tbody>
              {competitiveHeadToHead.rows.map((r) => (
                <tr class="border-b border-white/5">
                  <th scope="row" class="py-3 pr-6 text-sm font-medium text-white text-left">{r.system}</th>
                  <td class="py-3 px-6 text-sm text-muted-light font-mono">{r.judge1}</td>
                  <td class="py-3 px-6 text-sm text-muted-light font-mono">{r.judge2}</td>
                  <td class="py-3 pl-6 text-sm text-muted">{r.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-muted text-sm mt-6 leading-relaxed max-w-3xl">
          Cross-judge spread <strong class="text-muted-light">0.0 on every cell</strong> (both judges
          agreed) — every number survives. Comis and mem0 score <strong class="text-muted-light">the
          same</strong> (both 7/8): at N=8 a tie, not a win — <strong class="text-muted-light">competitive-with,
          never a superiority claim.</strong> Both clear the full-dump control by +37.5 pt (the bench discriminates).
        </p>
        <p class="text-muted text-sm mt-4 leading-relaxed max-w-3xl">{competitiveHeadToHead.capabilityNote}</p>
        <p class="text-muted text-sm mt-4 leading-relaxed max-w-3xl italic">{competitiveHeadToHead.scopeNote}</p>
        <p class="mt-6">
          <a href={`${repoTree}/${competitiveHeadToHead.manifest}`} rel="noopener noreferrer" target="_blank" class="text-teal hover:text-teal-dark transition-colors font-mono text-sm">manifest &rarr;</a>
        </p>
      </div>
    </section>

    <!-- Honest head-to-head — reproduce/extend via the gate (NO fabricated cell) -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-4xl mx-auto">
        <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">Head-to-head</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Reproduce or extend it via the gate</h2>
        <p class="text-muted text-lg mb-8 max-w-2xl leading-relaxed">{headToHead.copy}</p>
        <div class="bg-navy-light/80 border border-white/5 rounded-xl p-6 font-mono text-sm text-muted-light mb-8 overflow-x-auto">
          <pre class="whitespace-pre font-mono">{headToHead.command}</pre>
        </div>
        <div class="bg-navy border border-teal/15 rounded-xl p-6">
          <p class="text-muted text-sm leading-relaxed">{headToHead.coi}</p>
        </div>
        <p class="mt-8">
          <a href={methodologyUrl} rel="noopener noreferrer" target="_blank" class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-3 font-semibold text-white hover:border-teal/40 transition-colors">
            Full methodology + how to reproduce &rarr;
          </a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
