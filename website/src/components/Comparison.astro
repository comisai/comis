---
import { SECURITY } from "../data/security";
import { FACTS } from "../data/facts";

const rows = [
  { label: "Authentication", them: "Often missing or optional", us: "Required by default, mTLS support", win: true },
  { label: "Prompt injection", them: "No detection", us: `Input and output scanning, canary tokens, isolated external content - ${SECURITY.layerFraming}`, win: true },
  { label: "Memory safety", them: "Single trust level, poisonable", us: "Trust-partitioned - your words vs. the internet's", win: true },
  { label: "Secrets", them: "Often plaintext or process-level", us: "AES-256-GCM encrypted at rest, never in logs or tool output", win: true },
  { label: "Credentialed exec - keys never in sandbox", them: "Usually passes secrets into the process", us: "Credential broker injects at the network boundary; the agent never receives the key", win: true },
  { label: "Tool access", them: "Unchecked shell by default in many setups", us: "Approval gates, per-agent policies, and sandboxed exec where supported", win: true },
  { label: "Skill safety", them: "Install and hope", us: `Allowlists, scope isolation, ${SECURITY.contentScannerRules}-rule content scan at load time`, win: true },
  { label: "Network safety", them: "No SSRF protection", us: "Private network + metadata endpoints blocked", win: true },
  { label: "Audit trail", them: "None", us: "Every action logged and classified", win: true },
  { label: "Context management", them: "Truncate and hope", us: "DAG-backed recovery plus compaction: compression remains inspectable instead of becoming a black box", win: true },
  { label: "Tool overhead", them: "All tool definitions on every turn", us: "Progressive disclosure: lean definitions, just-in-time guides, context-aware deferral", win: true },
  { label: "Small model support", them: "Same bloated context for all models", us: "Model-aware scaffold: pruned schemas + focused tool sets + prompt-size budgets, plus reliability rails (goal anchor, JSON repair, self-correction) and a stricter security floor", win: true },
  { label: "Memory", them: "Session-only, no recall", us: "Memory that learns, not just remembers: trust-first recall, proof-accruing observations, optional reranking, and feedback", win: true },
  { label: "Budget", them: "Unlimited spend", us: "Three-tier budget guard: per-execution, per-hour, per-day", win: true },
  { label: "Agents", them: "One does everything", us: "A team of specialists", win: true },
  { label: "Channels", them: "Varies", us: `${FACTS.channels} platforms with platform-aware delivery`, win: true },
  { label: "Models", them: "Often locked to one provider", us: "Any model, any provider", win: true },
  { label: "Source", them: "Closed or partially open", us: "Fully open source, Apache-2.0", win: true },
];
---

<section class="px-6 py-20 md:py-28 bg-navy-light/50">
  <div class="max-w-4xl mx-auto">
    <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">How it compares</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
      What an agent platform should have.
    </h2>
    <p class="text-muted text-lg mb-14 max-w-2xl">
      Here's the bar Comis holds itself to, capability by capability. Want a head-to-head with named, excellent alternatives instead? Our
      <a href="/compare" class="text-teal hover:text-teal-dark underline transition-colors">honest comparison</a>
      credits OpenClaw and Hermes where they win, and shows where Comis is the better fit.
    </p>

    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-white/10">
            <th scope="col" class="py-3 pr-6 text-sm font-medium text-muted">Capability</th>
            <th scope="col" class="py-3 px-6 text-sm font-medium text-muted">What you often get</th>
            <th scope="col" class="py-3 pl-6 text-sm font-semibold text-coral">Comis</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-white/5">
              <th scope="row" class="py-3.5 pr-6 text-sm font-medium text-white whitespace-nowrap text-left">{r.label}</th>
              <td class="py-3.5 px-6 text-sm text-muted/60">{r.them}</td>
              <td class="py-3.5 pl-6 text-sm text-muted-light font-medium">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-10">
      <a href="/compare" class="inline-flex items-center gap-2 text-coral hover:text-coral-dark font-medium transition-colors">
        See the full comparison
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
