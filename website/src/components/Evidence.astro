---
// SPDX-License-Identifier: Apache-2.0
const evidenceCommands = [
  ["comis explain <session>", "Outcome, cost, tool failures, breaker timeline, and a likely root cause for one session."],
  ["comis fleet --since 24", "Daemon-wide triage: degraded rate, top error kinds, cost, and configuration posture."],
  ["comis security audit-log", "Who accessed a secret and what was blocked: scrubbed, durable, reviewable."],
] as const;
---

<section class="surface-section" data-section="evidence" aria-labelledby="evidence-heading">
  <div class="container evidence-grid">
    <div>
      <p class="eyebrow">Operational evidence</p>
      <h2 id="evidence-heading">When something fails, one command explains why.</h2>
      <p class="lead">
        Agent failures are usually reconstructed by hand from scattered logs. Comis records evidence at every boundary (model calls, tool calls, policy decisions, memory writes, spend) so the question has a direct answer.
      </p>
      <p class="lead">
        Reports are deterministic (same input, same verdict), bounded, and content-safe: counts and hints, never message bodies or secrets. Share them in an incident review as-is.
      </p>
    </div>

    <figure class="command-panel evidence-panel">
      <p class="technical-label">Evidence in one call</p>
      {evidenceCommands.map(([command, description]) => (
        <div class="evidence-command">
          <div class="command-line">
            <span class="prompt" aria-hidden="true">$</span>
            <code>{command}</code>
          </div>
          <p class="evidence-description">{description}</p>
        </div>
      ))}
      <figcaption class="development-note">Report fields summarized; see the observability documentation for full schemas.</figcaption>
    </figure>
  </div>
</section>
