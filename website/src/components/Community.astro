import { SITE } from "../data/site";
---

<section class="surface-section community-section" data-section="community" aria-labelledby="community-heading">
  <div class="reading-container centered-section">
    <p class="eyebrow">Open source</p>
    <h2 id="community-heading">Help shape Comis while it is still early.</h2>
    <p class="lead">
      Contributors can work on the core runtime, integrations, or documentation and developer experience. Behavior changes follow test-first development and the repository’s architecture and security gates.
    </p>
    <a class="button button-primary" href={SITE.github}>View on GitHub</a>
    <nav class="contributor-links" aria-label="Contributor resources">
      <a class="text-link" href={SITE.issues}>Browse open issues</a>
      <a class="text-link" href={SITE.discussions}>Start a discussion</a>
      <a class="text-link" href={SITE.contributing}>Read the contribution guide</a>
    </nav>
    <p>If Comis is useful, star the repository to help other contributors discover it.</p>
  </div>
</section>
