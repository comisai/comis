import { SITE } from "../data/site";
---

<section class="surface-section community-section" data-section="community" aria-labelledby="community-heading">
  <div class="reading-container centered-section">
    <p class="eyebrow">Open source</p>
    <h2 id="community-heading">Help make agent governance reproducible.</h2>
    <p class="lead">
      Contribute governance scenarios, standards integrations, runtime fixes, deployment recipes, evidence views, or documentation. Changes are checked by test, architecture, and security gates.
    </p>
    <a class="button button-primary" href={SITE.github}>Explore the repository</a>
    <nav class="contributor-links" aria-label="Contributor resources">
      <a class="text-link" href={SITE.issues}>Report an issue</a>
      <a class="text-link" href={SITE.discussions}>Propose a governance scenario</a>
      <a class="text-link" href={SITE.contributing}>Read the contribution guide</a>
    </nav>
  </div>
</section>
