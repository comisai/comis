import { SITE } from "../data/site";
---

<section class="surface-section community-section" data-section="community" aria-labelledby="community-heading">
  <div class="reading-container centered-section">
    <p class="eyebrow">Open source</p>
    <h2 id="community-heading">Help make persistent agents easier to trust.</h2>
    <p class="lead">
      Comis Reliability Trials are a planned way to turn real failures into small, repeatable tests.
    </p>
    <p class="supporting-copy">Contribute a failure story, fixture, validator, adapter, documentation, or focused runtime fix.</p>
    <a class="button button-primary" href={SITE.github}>Contribute on GitHub</a>
    <nav class="contributor-links" aria-label="Contributor resources">
      <a class="text-link" href={SITE.issues}>Report an issue</a>
      <a class="text-link" href={SITE.discussions}>Start a discussion</a>
      <a class="text-link" href={SITE.contributing}>Contribution guide</a>
    </nav>
  </div>
</section>
