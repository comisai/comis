<section id="reliability" class="surface-section reliability-section" data-section="reliability" aria-labelledby="reliability-heading">
  <div class="container reliability-grid">
    <div class="reliability-copy">
      <p class="eyebrow">Recorded evidence</p>
      <h2 id="reliability-heading">Failure should leave evidence, not a mystery.</h2>
      <p class="lead">
        Comis <code>explain</code> builds a bounded report from recorded runtime evidence. It makes no model calls and does not invent a cause when no rule matches.
      </p>
      <p class="supporting-copy">
        Reports are designed to exclude raw message bodies and credential values. Error details may be sanitized, shortened, or replaced with a digest.
      </p>
    </div>

    <figure class="terminal-panel diagnosis-panel">
      <div class="panel-bar">
        <div class="panel-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="panel-title">recorded test case</span>
      </div>
      <div class="diagnosis-body">
        <div class="command-line">
          <span class="prompt" aria-hidden="true">$</span>
          <code>comis explain &lt;sessionKey|traceId|rootRunId&gt;</code>
        </div>
        <dl class="diagnosis-facts" data-diagnosis-fixture>
          <div>
            <dt>Outcome</dt>
            <dd><span class="status-mark" aria-hidden="true"></span>degraded</dd>
          </div>
          <div>
            <dt>Attributed cost</dt>
            <dd>$1.320669</dd>
          </div>
          <div>
            <dt>Likely cause</dt>
            <dd class="cause-value">
              <span>Successful web content was mistaken for a failure.</span>
              <code>content_heuristic_misclassification</code>
            </dd>
          </div>
          <div>
            <dt>Model calls to explain</dt>
            <dd class="zero-value">0</dd>
          </div>
        </dl>
      </div>
      <figcaption>Built-in test result; not a customer result.</figcaption>
    </figure>
  </div>
</section>
