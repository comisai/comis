---
import { FACTS } from "../data/facts";

const features = [
  { icon: "context", title: "Context that stays useful", desc: "Comis trims dead content, compacts old turns, rehydrates active state, and can recover detail through DAG-backed context tools. Long sessions stay coherent without turning every request into a full transcript dump." },
  { icon: "automate", title: "Automate real routines", desc: "Graph pipelines run multi-step work on demand or on a schedule. Scan the news, summarize email, check a calendar, compile a briefing, and deliver it to the right channel before the day starts." },
  { icon: "tools", title: "Tools without blind trust", desc: `Built-in tools cover files, web search, browser automation, media processing, and sandboxed shell execution. Add ${FACTS.mcp}; Comis bundles none of them, so you choose exactly what to trust.` },
  { icon: "media", title: "Voice, images, and files", desc: "Send a voice note, get a useful reply. Analyze images with vision models, transcribe audio with Whisper, Groq, or Deepgram, and generate speech with OpenAI, ElevenLabs, or Edge TTS." },
  { icon: "models", title: "Use the model that fits", desc: `${FACTS.models}. Different agents can use different models, from local small models to frontier hosted models, while the same policies, credential handling, and audit trail stay in place.` },
  { icon: "memory", title: "Memory that learns, not just remembers", desc: "Comis combines SQLite, FTS5 search, vector recall, optional on-device reranking, trust-ranked memory, evidence-backed observations, and an opt-in feedback loop so useful memories get easier to retrieve over time." },
  { icon: "key", title: "Credential broker", desc: "Run API-key CLIs while keeping real secrets in the daemon's encrypted store. The tool authenticates through the broker; the agent never gets the key in its sandbox or output stream." },
];
---

<section class="px-6 py-20 md:py-28 bg-navy-light/50">
  <div class="max-w-5xl mx-auto">
    <p class="text-teal font-semibold text-sm uppercase tracking-widest mb-4">What you can do</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-14">
      Real tools. Real workflows. Real results.
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((f) => (
        <div class="bg-navy/80 border border-white/5 rounded-xl p-8">
          <h3 class="text-xl font-semibold text-white mb-3">{f.title}</h3>
          <p class="text-muted leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
