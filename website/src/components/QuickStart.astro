---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";
---

<section id="install" class="install-section" data-section="install" aria-labelledby="install-heading">
  <div class="reading-container install-copy">
    <p class="eyebrow">Quick start</p>
    <h2 id="install-heading">Install Comis on your infrastructure.</h2>
    <p class="lead">Choose the managed host installer or a smaller npm installation.</p>

    <div class="command-panel">
      <div class="command-line" role="region" tabindex="0" aria-label="One-line installer command">
        <span class="prompt" aria-hidden="true">$</span>
        <code id="install-command" data-install-command>{SITE.installCommand}</code>
      </div>
      <button class="copy-button" type="button" data-copy-button hidden>
        <span data-copy-label>Copy command</span>
      </button>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </div>

    <div class="install-options">
      <article class="install-option">
        <h3>Review before running</h3>
        <p>Download with <code>curl -fsSL --proto '=https' --tlsv1.2 https://comis.ai/install.sh -o comis-install.sh</code>, inspect it with <code>less comis-install.sh</code>, then run <code>bash comis-install.sh --dry-run</code>.</p>
      </article>
      <article class="install-option">
        <h3>Managed host</h3>
        <p>The installer can add Node.js and host dependencies, initialize data, and register systemd or PM2. On Linux it can also provision Chromium, Xvfb, and a dedicated service user.</p>
      </article>
      <article class="install-option">
        <h3>Direct npm</h3>
        <p>With Node.js 22.19 or newer, run <code>npm install --global comisai</code>, then <code>comis init</code>. This path does not install host tools or register a service.</p>
      </article>
    </div>
    <p>
      Complete setup, then open <code>http://127.0.0.1:4766</code>. Linux with Bubblewrap is the recommended target for isolated tool execution.
    </p>
    <a class="text-link standalone-link" href={SITE.installationDocs}>View all installation options</a>
  </div>
</section>

<script is:inline type="module" src="/copy-command.js"></script>
