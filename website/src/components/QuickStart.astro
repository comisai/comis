---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";
---

<section id="install" class="install-section" data-section="install" aria-labelledby="install-heading">
  <div class="reading-container install-copy">
    <p class="eyebrow">Quick start</p>
    <h2 id="install-heading">Install Comis on a host you control.</h2>
    <p class="lead">
      The managed installer can add Node.js, host tools, and a background service. Direct npm install keeps host setup in your hands.
    </p>

    <div class="command-panel install-command-panel">
      <div class="command-line" role="region" tabindex="0" aria-label="One-line installer command">
        <span class="prompt" aria-hidden="true">$</span>
        <code id="install-command" data-install-command>{SITE.installCommand}</code>
      </div>
      <button class="copy-button" type="button" data-copy-button hidden>
        <span data-copy-label>Copy command</span>
      </button>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </div>

    <div class="install-options">
      <article class="install-option">
        <p class="technical-label">Review first</p>
        <p>Download with <code>curl -fsSL --proto '=https' --tlsv1.2 https://comis.ai/install.sh -o comis-install.sh</code>, inspect the file, then run <code>bash comis-install.sh --dry-run</code>.</p>
      </article>
      <article class="install-option">
        <p class="technical-label">Use npm</p>
        <p>With Node.js 22.19 or newer, run <code>npm install --global comisai</code>, then <code>comis init</code>.</p>
      </article>
    </div>

    <a class="text-link standalone-link" href={SITE.installationDocs}>Read the installation guide</a>
  </div>
</section>

<script is:inline type="module" src="/copy-command.js"></script>
