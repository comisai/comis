---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const workflow = [
  ["Receive", "A channel or API submits work."],
  ["Route", "A binding selects the configured agent."],
  ["Coordinate", "A durable execution graph runs sequential or parallel work."],
  ["Use tools", "Policies and configured approvals govern supported tool paths."],
  ["Deliver", "Comis returns the result and records operational evidence."],
] as const;
---

<section class="hero" data-section="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow status-line"><span aria-hidden="true"></span>{SITE.status}</p>
      <h1 id="hero-heading">An open-source, security-first platform for AI agent teams.</h1>
      <p class="lead hero-lead">
        Run specialized agents across messaging, APIs, schedules, and durable workflows on infrastructure you control, with recoverable context and operational visibility.
      </p>
      <div class="hero-actions" role="group" aria-label="Get started">
        <a class="button button-primary" href="#install">Get started</a>
        <a class="button button-secondary" href={SITE.github}>View on GitHub</a>
        <a class="text-link action-link" href={SITE.docs}>Read the docs</a>
      </div>
    </div>

    <figure class="workflow-panel">
      <p class="technical-label">Example execution</p>
      <h2>From message to traceable result</h2>
      <ol class="workflow-list">
        {workflow.map(([title, description], index) => (
          <li class="workflow-step">
            <span class="workflow-number" aria-hidden="true">{index + 1}</span>
            {index < workflow.length - 1 && <span class="workflow-connector" aria-hidden="true"></span>}
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
      <figcaption>Illustrative workflow; not a customer deployment.</figcaption>
    </figure>
  </div>
</section>
