---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const checks = ["Origin", "Capability", "Credential", "Budget"] as const;
---

<section class="hero" data-section="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status-line"><span aria-hidden="true"></span>{SITE.status}</p>
      <p class="hero-kicker">Security-first agent runtime</p>
      <h1 id="hero-heading">Let agents learn and act. Keep authority in the runtime.</h1>
      <p class="lead hero-lead">
        Comis is an open-source, self-hosted, security-first runtime for agents that work across sessions. It can carry qualifying experience forward as sourced, correctable guidance, while configured runtime controls decide what the agent may do.
      </p>
      <div class="hero-actions" role="group" aria-label="Explore Comis">
        <a class="button button-primary" href="#learning">See how Comis works</a>
        <a class="button button-secondary" href={SITE.securityDocs}>Read the security model</a>
        <a class="text-link action-link" href={SITE.github}>View on GitHub</a>
      </div>
    </div>

    <figure class="authority-panel" aria-labelledby="authority-panel-title">
      <div class="panel-bar">
        <span class="panel-title">Runtime authority gate</span>
        <span class="runtime-badge"><span aria-hidden="true"></span>Decision path</span>
      </div>
      <div class="authority-flow">
        <div class="flow-node flow-input">
          <span class="technical-label">Input</span>
          <strong>Prior guidance + new task</strong>
        </div>
        <span class="flow-connector" aria-hidden="true"></span>
        <div class="flow-node">
          <span class="technical-label">Model</span>
          <strong>Proposes an action</strong>
        </div>
        <span class="flow-connector" aria-hidden="true"></span>
        <div class="runtime-gate">
          <div class="gate-heading">
            <span class="technical-label">Runtime checks</span>
            <span class="gate-state">enforced</span>
          </div>
          <ul class="gate-checks" aria-label="Runtime checks">
            {checks.map((check) => <li><span aria-hidden="true"></span>{check}</li>)}
          </ul>
        </div>
        <div class="flow-outcomes" aria-label="Possible outcomes">
          <span class="outcome-allowed">Allowed</span>
          <span class="outcome-denied">Denied</span>
        </div>
        <div class="evidence-line"><span aria-hidden="true"></span>Decision and evidence recorded</div>
      </div>
      <figcaption id="authority-panel-title">Guidance can influence a proposal. It cannot grant itself permission.</figcaption>
    </figure>
  </div>
</section>
