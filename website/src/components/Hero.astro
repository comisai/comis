---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const workflow = [
  ["Receive", "A channel or API submits scoped work."],
  ["Route", "A binding selects an agent with configured policies."],
  ["Execute", "A typed graph coordinates sequential or parallel work."],
  ["Govern", "Capability gates, budgets, policies, and configured approvals constrain supported paths."],
  ["Record", "Comis records the result, cost, and operational evidence."],
] as const;
---

<section class="hero" data-section="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow status-line"><span aria-hidden="true"></span>{SITE.status}</p>
      <h1 id="hero-heading">Govern the execution, memory, security, authority, and cost of every agent.</h1>
      <p class="lead hero-lead">
        Comis unifies typed execution, recoverable context, trust-aware learning, layered security, scoped authority, cost governance, and operational evidence on your infrastructure.
      </p>
      <div class="hero-actions" role="group" aria-label="Get started">
        <a class="button button-primary" href="#install">Get started</a>
        <a class="button button-secondary" href={SITE.github}>View on GitHub</a>
        <a class="text-link action-link" href={SITE.docs}>Read the docs</a>
      </div>
    </div>

    <figure class="workflow-panel">
      <p class="technical-label">Governed execution</p>
      <h2>From request to governed result</h2>
      <ol class="workflow-list">
        {workflow.map(([title, description], index) => (
          <li class="workflow-step">
            <span class="workflow-number" aria-hidden="true">{index + 1}</span>
            {index < workflow.length - 1 && <span class="workflow-connector" aria-hidden="true"></span>}
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
      <figcaption>Illustrative workflow; not a customer deployment.</figcaption>
    </figure>
  </div>
</section>
