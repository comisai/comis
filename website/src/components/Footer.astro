<!-- SPDX-License-Identifier: Apache-2.0 -->
---
import { FACTS } from "../data/facts";
---

<footer class="px-6 py-16 border-t border-white/5">
  <div class="max-w-5xl mx-auto">
    <!-- CTA -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Join the community.
      </h2>
      <p class="text-muted text-lg mb-8">
        Comis is built in the open and designed for contributors. Try it, star it, fork it, open an issue, or help improve the agent platform your own workflows can run on.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contribute" class="inline-flex items-center justify-center px-6 py-3 bg-coral-btn hover:bg-coral-btn-hover text-white font-semibold rounded-lg transition-colors">
          Contribute
        </a>
        <a href="https://github.com/comisai/comis" rel="noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-white/10 hover:bg-white/15 text-white font-medium rounded-lg transition-colors border border-white/10">
          GitHub
        </a>
        <a href="https://discord.gg/FsqgJkpp" rel="noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-white/10 hover:bg-white/15 text-white font-medium rounded-lg transition-colors border border-white/10">
          Discord
        </a>
        <a href="https://twitter.com/comis_ai" rel="noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-white/10 hover:bg-white/15 text-white font-medium rounded-lg transition-colors border border-white/10">
          Twitter
        </a>
      </div>

      <!-- Contributor funnel teaser (the footer half of conversion goal #3; the full path is /contribute) -->
      <div class="mt-10 max-w-2xl mx-auto text-left bg-white/5 border border-white/10 rounded-xl p-6">
        <p class="text-sm text-muted leading-relaxed">
          The rules are executable - <code class="text-teal">pnpm validate</code> runs the same gates CI does, so contributors can work against clear expectations.
        </p>
        <p class="text-sm text-muted leading-relaxed mt-3">
          The protocol is written down - <code class="text-teal">AGENTS.md</code> is the engineering contract, and the extension points (channel adapters, skills/MCP, docs) are real interfaces, not stubs.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 mt-5 text-sm font-medium">
          <a href={FACTS.links.goodFirstIssue} rel="noopener noreferrer" target="_blank" class="text-white hover:text-teal transition-colors">
            Good first issue →
          </a>
          <a href="/contribute" class="text-white hover:text-teal transition-colors">
            Contribute →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-8 border-t border-white/5">
      <div class="flex items-center gap-3">
        <img src="/images/comis-logo.png" alt="Comis" class="h-8" />
        <span class="text-sm text-muted">{FACTS.spine}.</span>
      </div>

      <div class="flex items-center gap-6 text-sm text-muted">
        <a href="https://docs.comis.ai" rel="noopener noreferrer" target="_blank" class="hover:text-white transition-colors">Docs</a>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <a href="https://github.com/comisai/comis" rel="noopener noreferrer" target="_blank" class="hover:text-white transition-colors">GitHub</a>
        <a href="https://discord.gg/FsqgJkpp" rel="noopener noreferrer" target="_blank" class="hover:text-white transition-colors">Discord</a>
        <a href="https://twitter.com/comis_ai" rel="noopener noreferrer" target="_blank" class="hover:text-white transition-colors">Twitter</a>
      </div>

      <div class="text-sm text-muted">
        Apache-2.0 License
      </div>
    </div>

    <!-- Special thanks -->
    <p class="text-center text-xs text-muted mt-8">
      Special thanks to <a href="https://mariozechner.at/" rel="noopener noreferrer" target="_blank" class="underline hover:text-muted transition-colors">Mario Zechner</a> for <a href="https://github.com/badlogic/pi-mono" rel="noopener noreferrer" target="_blank" class="underline hover:text-muted transition-colors">pi-mono</a>.
    </p>

    <!-- Acknowledgments -->
    <p class="text-center text-xs text-muted mt-4 max-w-2xl mx-auto leading-relaxed">
      Comis stands on the work of the open-source agent community - studied closely, credited gladly. Comis's design center is a platform for teams and communities: isolated by design, with sandboxed tools, encrypted secrets, and auditable operations. Built on <a href="https://github.com/badlogic/pi-mono" rel="noopener noreferrer" target="_blank" class="underline hover:text-muted transition-colors">pi-mono</a>.
    </p>
  </div>
</footer>
