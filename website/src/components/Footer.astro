---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const links = [
  ["Documentation", SITE.docs],
  ["GitHub", SITE.github],
  ["Issues", SITE.issues],
  ["Security", SITE.security],
  ["Known limits", SITE.knownLimitations],
  ["Apache-2.0", SITE.license],
] as const;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <a class="brand-link" href="/" aria-label="Comis home">
        <img src="/images/comis-logo.png" alt="Comis" width="838" height="202" loading="lazy" decoding="async" />
      </a>
      <p>{SITE.positioning} Permission stays outside the prompt.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      {links.map(([label, href]) => <a class="text-link" href={href}>{label}</a>)}
    </nav>
  </div>
</footer>
