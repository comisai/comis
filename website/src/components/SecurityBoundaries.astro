---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const boundaries = [
  ["Isolation", "Linux with Bubblewrap is the recommended target. macOS isolation is best-effort and does not provide the same boundary."],
  ["Host execution", "The ordinary exec tool can run directly on the host when its sandbox is disabled or unavailable."],
  ["Authority defaults", "The default tool profile is full, and an empty per-agent secret allowlist is unrestricted. Narrow both before accepting untrusted input."],
  ["Approvals", "Approvals are disabled by default and protect only explicitly wired paths when enabled."],
] as const;
---

<section class="surface-section security-section" data-section="security" aria-labelledby="security-heading">
  <div class="container security-grid">
    <div class="security-copy">
      <p class="eyebrow">Security and deployment</p>
      <h2 id="security-heading">Start narrow. Expand after you test.</h2>
      <p class="lead">
        Comis treats model output and external content as untrusted, but safe operation still depends on your host and configuration.
      </p>
      <p class="supporting-copy">
        Self-hosted does not mean offline. Configured model, messaging, media, MCP, and tool providers may receive data you send to them.
      </p>
      <p class="scope-note">
        Comis does not claim complete tenant isolation, high availability, compliance certification, or commercial support.
      </p>
      <nav class="inline-links" aria-label="Security resources">
        <a class="text-link" href={SITE.securityDocs}>Security guide</a>
        <a class="text-link" href={SITE.threatModel}>Threat model</a>
        <a class="text-link" href={SITE.knownLimitations}>Known limitations</a>
      </nav>
    </div>

    <div class="boundary-list">
      {boundaries.map(([title, body], index) => (
        <article class="boundary-item">
          <span class="boundary-number" aria-hidden="true">0{index + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
