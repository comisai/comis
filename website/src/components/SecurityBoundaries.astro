---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const boundaries = [
  ["Isolation", "Linux with Bubblewrap is the recommended target. macOS isolation is best-effort and does not provide the same boundary."],
  ["Host execution", "The ordinary exec tool can run directly on the host when its sandbox is disabled or unavailable."],
  ["Authority defaults", "The default tool profile is full, and an empty per-agent secret allowlist is unrestricted. Narrow both before accepting untrusted input."],
  ["Skill permissions", "Skill-declared permissions are advisory unless the same limits are enforced through runtime tool policy and deployment controls."],
  ["Streaming", "Streaming consumers can receive deltas before the completed response passes its final output scan."],
  ["Approvals", "Approval requests are available on explicitly wired paths when enabled; they are not a universal policy engine."],
] as const;
---

<section class="surface-section" data-section="security" aria-labelledby="security-heading">
  <div class="container security-grid">
    <div>
      <p class="eyebrow">Security and deployment</p>
      <h2 id="security-heading">Layered security with explicit boundaries.</h2>
      <p class="lead">
        Comis treats external content and model output as untrusted. Controls include encrypted secrets, scoped authority, SSRF defenses, content wrapping, memory validation, output guards, tool policy, and audit events.
        Credentials resolve through a broker scoped by per-agent allowlists, with access recorded in the audit trail.
        The supply chain is disciplined too: dependencies are exact-pinned, workspace packages are bundled, and npm releases publish with sigstore provenance.
      </p>
      <div class="inline-links">
        <a class="text-link" href={SITE.threatModel}>Read the threat model</a>
        <a class="text-link" href={SITE.security}>Report a vulnerability</a>
      </div>
    </div>

    <div>
      <div class="boundary-list">
        {boundaries.map(([title, body]) => (
          <article class="boundary-item">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <p class="development-note">
        <strong>Enterprise-oriented foundation, under active development:</strong> evaluate identity, tenant isolation, availability, backup and restore, upgrades, and support before critical or regulated deployment. General exact replay remains incomplete.
      </p>
    </div>
  </div>
</section>
