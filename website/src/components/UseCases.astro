---
// SPDX-License-Identifier: Apache-2.0
import { SITE } from "../data/site";

const steps = [
  ["Gather", "Collect sources on a schedule."],
  ["Challenge", "Compare claims and record disagreements."],
  ["Preserve", "Keep findings available as the prompt changes."],
  ["Review", "Read the result or inspect a failed branch."],
] as const;
---

<section data-section="workflow" aria-labelledby="workflow-heading">
  <div class="container workflow-grid">
    <div class="workflow-copy">
      <p class="eyebrow">A useful first run</p>
      <h2 id="workflow-heading">A good first project: an overnight research brief.</h2>
      <p class="lead">
        A scheduled agent collects and compares sources, keeps useful findings available as older details are summarized, tracks cost when pricing is available, and records evidence for a failed branch.
      </p>
      <p class="supporting-copy">Start with read-only work. Add write access only after you test the controls on your host.</p>
      <a class="text-link standalone-link" href={SITE.useCases}>Explore use cases</a>
    </div>

    <ol class="workflow-steps">
      {steps.map(([title, body], index) => (
        <li class="workflow-step-card">
          <span class="step-number" aria-hidden="true">0{index + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
