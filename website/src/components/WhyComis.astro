// SPDX-License-Identifier: Apache-2.0
const differentiators = [
  {
    title: "Operational evidence",
    body: "Traces, audits, fleet health, and recall diagnostics feed deterministic incident explanation: one command reports outcome, cost, failures, and likely root cause.",
  },
  {
    title: "Bounded spend",
    body: "Provider cost accounting connects to graph budgets and configurable spend ceilings that stop a run when it crosses the line.",
  },
  {
    title: "Per-agent scoped authority",
    body: "Each agent gets its own model, memory and context scopes, tools, budgets, secret allowlist, and routing, enforced by capability gates.",
  },
  {
    title: "One execution graph",
    body: "A single request-scoped typed graph runs parallel work, barriers, retries, budgets, and approvals under the same governance model, with configured recovery.",
  },
  {
    title: "Recoverable canonical context",
    body: "Keep messages and tool results available beneath summaries, then recover selected detail on demand.",
  },
  {
    title: "Provenance-aware memory",
    body: "Learned state carries provenance and trust ceilings; corrections supersede rather than silently overwrite, so fixes hold. Memory you can inspect and audit.",
  },
] as const;
---

<section data-section="why-comis" aria-labelledby="why-heading">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Why Comis</p>
      <h2 id="why-heading">Govern execution, memory, security, authority, and cost as one system.</h2>
      <p class="lead">
        <strong>Comis's advantage is coherence.</strong> Formal workflows, recoverable context, provenance-aware memory, scoped authority, bounded spend, and operational evidence share one governance model, enforced inside the runtime rather than by a proxy in front of it.
      </p>
    </div>

    <div class="editorial-grid advantage-grid">
      {differentiators.map((item, index) => (
        <article class="editorial-item advantage-item">
          <p class="technical-label" aria-hidden="true">0{index + 1}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
