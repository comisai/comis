---
// SPDX-License-Identifier: Apache-2.0
const differentiators = [
  {
    title: "Typed execution",
    body: "Coordinate sequential and parallel DAG nodes with barriers, retries, budgets, and configured recovery.",
  },
  {
    title: "Recoverable canonical context",
    body: "Keep messages and tool results available beneath summaries, then recover selected detail on demand.",
  },
  {
    title: "Provenance-aware memory",
    body: "Rank and revise learned state using provenance, corroboration, trust ceilings, outcomes, and corrections.",
  },
  {
    title: "Scoped authority and layered security",
    body: "Treat models as untrusted with scoped state, capability gates, encrypted secrets, and content guards.",
  },
  {
    title: "Bounded spend",
    body: "Combine provider cost accounting, graph budgets, and opt-in spend ceilings.",
  },
  {
    title: "Operational evidence",
    body: "Connect traces, incident explanation, audits, fleet health, and recall diagnostics for investigation.",
  },
] as const;
---

<section data-section="why-comis" aria-labelledby="why-heading">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Why Comis</p>
      <h2 id="why-heading">Govern the whole agent lifecycle as one system.</h2>
      <p class="lead">
        <strong>Comis's advantage is coherence.</strong> Execution, context, memory, authority, cost, and evidence share one governance model.
      </p>
    </div>

    <div class="editorial-grid advantage-grid">
      {differentiators.map((item, index) => (
        <article class="editorial-item advantage-item">
          <p class="technical-label" aria-hidden="true">0{index + 1}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
