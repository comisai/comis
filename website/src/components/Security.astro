---
import { SECURITY } from "../data/security";

const threats = [
  {
    threat: "Remote code execution",
    desc: "Attackers hijack agents through exposed endpoints and WebSocket connections.",
    answer: "Authenticated by default.",
    detail: "mTLS gateway, bearer token auth, no open ports without explicit configuration.",
  },
  {
    threat: "Unchecked tool access",
    desc: "An agent with shell and file access can read, write, and run anything on your machine.",
    answer: "Kernel-enforced exec sandbox - on by default.",
    detail: "Tools run jailed by the operating system itself, not by a setting you have to remember to switch on. No network by default; agents can only see their own workspace, not your host system.",
  },
  {
    threat: "Prompt injection",
    desc: "Malicious instructions hidden in web pages or fetched content trick agents into executing attacker commands.",
    answer: "The LLM is treated as the attack surface.",
    detail: "Input is scanned, output is scanned, canary tokens catch leaks, and external content is wrapped and isolated so the model can never confuse fetched text for an instruction - layered runtime defenses, benchmarked.",
  },
  {
    threat: "Malicious skills",
    desc: "Community skills that hide exfiltration, injection, or breakout payloads.",
    answer: "Every skill is screened before it can run.",
    detail: `${SECURITY.contentScannerRules} content-scanner rules covering exec injection, exfiltration, and XML breakout are applied at skill load time. (This is the canonical ${SECURITY.contentScannerRules} - it belongs to the skill content scanner, not to log redaction.)`,
  },
  {
    threat: "Malicious tool servers",
    desc: "A third-party MCP server could ship a known-bad package that runs the moment it starts.",
    answer: "MCP malware screening.",
    detail: "MCP packages are checked against the OSV malware database before they ever spawn for the first time.",
  },
  {
    threat: "Memory poisoning",
    desc: "Attackers modify an agent's persistent memory to change its behavior over time.",
    answer: "Trust-partitioned memory.",
    detail: "What an untrusted sender says can never overwrite what the system has verified. The trust weight is structurally frozen, so learning can never be poisoned into overriding a verified fact.",
  },
  {
    threat: "Credential exposure",
    desc: "API keys and secrets leaked through logs, tool outputs, or unencrypted storage.",
    answer: "Encrypted secrets.",
    detail: "AES-256 at rest. Secrets are kept out of logs, tool output, and chat responses.",
  },
  {
    threat: "Credential exposure via agentic CLIs",
    desc: "An agent running shell commands can read any secret in its environment - `cat ~/.claude/.credentials.json`, `env`, `/proc/self/environ`. Handing a key to the agent process means it can steal and exfiltrate it.",
    answer: "Credential broker - keys never meet agents.",
    detail: "The real key never enters the sandbox. It stays in the daemon's encrypted store; the CLI runs with a placeholder. The broker injects the real credential at the TLS network boundary - `cat`/`env`/`/proc` inside the sandbox show nothing. Broker fails closed: no secret → 502, request never forwarded.",
  },
  {
    threat: "Destructive actions with no oversight",
    desc: "Agents that delete, send, or spend without anyone signing off.",
    answer: "Action classifier - fail closed.",
    detail: "Destructive actions pause for your sign-off via chat buttons. Unknown action types classify as destructive and fail closed, so a new capability can't slip through unguarded.",
  },
  {
    threat: "Data exfiltration",
    desc: "Agents tricked into sending private data to external servers.",
    answer: "SSRF protection.",
    detail: "Outbound requests to private networks, localhost, and cloud metadata endpoints are blocked.",
  },
  {
    threat: "No audit trail",
    desc: "When something goes wrong, there's no record of what happened.",
    answer: "Full audit system.",
    detail: "Every security-relevant action is logged, classified, and traceable with trace IDs.",
  },
];
---

<section class="px-6 py-20 md:py-28">
  <div class="max-w-5xl mx-auto">
    <p class="text-coral font-semibold text-sm uppercase tracking-widest mb-4">Security deep dive</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
      Security that's engineered in, not bolted on.
    </h2>
    <p class="text-muted text-lg mb-14 max-w-2xl">
      Other AI agents ship fast and patch later. Comis was designed from day one around the question: what happens when an AI agent has real power and someone tries to abuse it?
    </p>

    <div class="grid md:grid-cols-2 gap-6">
      {threats.map((t) => (
        <div class="bg-navy-light/50 border border-white/5 rounded-xl p-6 hover:border-coral/20 transition-colors">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-2 h-2 rounded-full bg-red-400 mt-2.5"></div>
            <div class="flex-1">
              <p class="text-sm text-muted mb-2">{t.threat}: {t.desc}</p>
              <p class="text-white font-semibold">
                <span class="text-coral">&rarr;</span> {t.answer}
              </p>
              <p class="text-sm text-muted-light mt-1">{t.detail}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="text-center mt-14 text-lg text-muted">
      Other agents ask you to trust them. <span class="text-white font-semibold">Comis gives you reasons to.</span>
    </p>
    <div class="text-center mt-6">
      <a href="/security" class="inline-flex items-center gap-2 text-sm font-semibold text-coral hover:text-coral-dark transition-colors">
        Deep dive: {SECURITY.layerFraming}, including kernel-enforced OS-level sandboxing
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
    </div>
  </div>
</section>
