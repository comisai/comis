---
// SPDX-License-Identifier: Apache-2.0
const capabilities = [
  ["Connect", "Use ten messaging adapters, cloud or local models, built-in tools, filtered MCP clients, and media providers."],
  ["Operate", "Route agents through the dashboard, CLI, JSON-RPC, WebSocket, schedules, sub-agents, and durable graphs."],
  ["Store and observe", "Keep runtime state in local SQLite, encrypt credentials by default, and extend visibility with optional OpenTelemetry and Prometheus."],
] as const;
---

<section data-section="capabilities" aria-labelledby="capabilities-heading">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Core capabilities</p>
      <h2 id="capabilities-heading">Operate agents across channels, tools, state, and schedules.</h2>
      <p class="lead">
        The runtime and operational stores can run locally. Configured model, embedding, channel, tool, and media providers may receive routed data.
      </p>
    </div>

    <div class="editorial-grid editorial-grid-two">
      {capabilities.map(([title, body], index) => (
        <article class="editorial-item capability-item">
          <p class="technical-label">0{index + 1}</p>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
