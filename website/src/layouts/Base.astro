---
// SPDX-License-Identifier: Apache-2.0
import Nav from "../components/Nav.astro";
import { SITE } from "../data/site";
import "../styles/global.css";
import socialImage from "../../../assets/comis-social-preview.png";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? SITE.url);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/android-chrome-512x512.png`,
      description: SITE.positioning,
      sameAs: [SITE.githubOrganization],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${SITE.url}/#source`,
      name: "Comis source code",
      description: SITE.positioning,
      codeRepository: SITE.github,
      license: SITE.license,
      programmingLanguage: ["TypeScript", "Shell"],
      runtimePlatform: "Node.js 22.19 or newer",
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE.url}/#application`,
      name: SITE.name,
      description: SITE.description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS",
      downloadUrl: SITE.npm,
      softwareRequirements: "Node.js 22.19 or newer",
      isAccessibleForFree: true,
      license: SITE.license,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08111e" />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Comis: Governed learning, bounded action, recorded evidence." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Comis: Governed learning, bounded action, recorded evidence." />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav />
    <slot />
  </body>
</html>
