# Comis token-fixture generation — operator config TEMPLATE.
# Copy to scripts/token-fixtures/token-fixtures.env and adjust.
# run.sh sources this file automatically. Never commit real keys.

# ── Anthropic count_tokens (leg A) ──────────────────────────────
ANTHROPIC_API_KEY=
# Use a CURRENT-tokenizer model id — Fable-5-class models use the new
# tokenizer (~30% more tokens than older models); counting against an
# old id under-measures the worst Anthropic case.
ANTHROPIC_COUNT_MODEL=claude-fable-5

# ── Local qwen-class GGUF (leg B — the served family) ───────────
# Discover the local Ollama blob path with:
#   ollama show qwen3-coder:30b --modelfile | grep '^FROM'
# NOTE: qwen3.6 (`qwen35`-arch) blobs do NOT load in node-llama-cpp 3.18.1 —
# use the qwen3-coder blob or any small Qwen-family GGUF (see README.md).
QWEN_GGUF_PATH=
