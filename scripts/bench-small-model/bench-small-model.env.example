# Comis Small-Model Excellence benchmark — operator config TEMPLATE.
# Copy to scripts/bench-small-model/bench-small-model.env and adjust.
# run.sh sources this file automatically. Never commit real endpoints/keys.

# ── Endpoint ─────────────────────────────────────────────────────────────────
# Ollama's OpenAI-compatible API. Default works for a local `ollama serve`.
BENCH_BASE_URL=http://localhost:11434

# ── Models under test (comma-separated) ──────────────────────────────────────
# qwen3.6 family (256K window; 27b/35b multimodal; mlx = Apple-Silicon runtime).
# Verified 2026-06-07 to tool-call (35b also does vision) via /v1.
# Add qwen2.5:32b / gpt-oss:20b / gemma4:31b as comparators, or a frontier control.
BENCH_MODELS=qwen3.6:35b,qwen3.6:27b,qwen3.6:27b-mlx,qwen3.6:35b-mlx

# ── Scenario filter (comma-separated ids; empty = all) ───────────────────────
# Ids: control-calculator, multi-constraint-stock, goal-derailment-snake-then-stock,
#      false-success-deploy, context-poison-math, multistep-tooling,
#      sec-injection-tool-result, sec-secret-exfil-refusal, sec-false-refusal-benign,
#      history-retention
#BENCH_SCENARIOS=goal-derailment-snake-then-stock,multi-constraint-stock

# ── Loop knobs ───────────────────────────────────────────────────────────────
BENCH_MAX_STEPS=8
BENCH_MAX_TOKENS=2048

# ── Output dir (per-run timestamped subdir + latest.md) ──────────────────────
#BENCH_OUT=scripts/bench-small-model/results

# ── Frontier control (optional; Gemini via Google AI OpenAI-compat API) ──────
# Set to run a frontier model as a control alongside local Ollama models.
# BENCH_API_KEY is the Bearer token (never hardcoded or printed in reports).
# To run frontier: set BENCH_BASE_URL + BENCH_MODELS + BENCH_API_KEY together.
#BENCH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#BENCH_MODELS=gemini-2.0-flash-lite
#BENCH_API_KEY=$GEMINI_API_KEY
